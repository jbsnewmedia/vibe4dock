services:
  web:
    container_name: {{VIBE4DOCK_TARGET_CONTAINER}}
    build: ./docker/web
    working_dir: /app
    user: application
{{!PORTS_ONLY}}    ports:
{{!PORTS_ONLY}}      - "{{VIBE4DOCK_WEB_HOST_PORT}}:{{VIBE4DOCK_WEB_CONTAINER_PORT}}"
{{!PORTS_ONLY}}      - "{{VIBE4DOCK_ROOT_SHELL_HOST_PORT}}:{{VIBE4DOCK_ROOT_SHELL_CONTAINER_PORT}}"
{{!PORTS_ONLY}}      - "{{VIBE4DOCK_APP_SHELL_HOST_PORT}}:{{VIBE4DOCK_APP_SHELL_CONTAINER_PORT}}"
{{!PATHS_ONLY}}    expose:
{{!PATHS_ONLY}}      - "{{VIBE4DOCK_WEB_CONTAINER_PORT}}"
{{!PATHS_ONLY}}      - "{{VIBE4DOCK_ROOT_SHELL_CONTAINER_PORT}}"
{{!PATHS_ONLY}}      - "{{VIBE4DOCK_APP_SHELL_CONTAINER_PORT}}"
    volumes:
      - ./:/app
    tmpfs:
      - /tmp:exec,mode=1777
    environment:
      - WEB_DOCUMENT_ROOT=/app/public
      - PHP_DISPLAY_ERRORS=1
      - PHP_MEMORY_LIMIT=512M
      - PHP_MAX_EXECUTION_TIME=300
      - PHP_POST_MAX_SIZE=200M
      - PHP_UPLOAD_MAX_FILESIZE=100M
      - PHP_DISMOD=ioncube
      - TERM=xterm-256color
{{!PATHS_ONLY}}      - VIBE4DOCK_ROUTING={{VIBE4DOCK_ROUTING}}
{{!PATHS_ONLY}}      - VIBE4DOCK_BASE_PATH_PREFIX={{VIBE4DOCK_BASE_PATH_PREFIX}}
{{!PATHS_ONLY}}      - VIBE4DOCK_BASE_PATH_ROOT_SHELL={{VIBE4DOCK_BASE_PATH_ROOT_SHELL}}
{{!PATHS_ONLY}}      - VIBE4DOCK_BASE_PATH_APP_SHELL={{VIBE4DOCK_BASE_PATH_APP_SHELL}}
  tools:
    build: ./docker/tools
{{!PORTS_ONLY}}    ports:
{{!PORTS_ONLY}}      - "{{VIBE4DOCK_TOOLS_HOST_PORT}}:{{VIBE4DOCK_TOOLS_CONTAINER_PORT}}"
{{!PATHS_ONLY}}    expose:
{{!PATHS_ONLY}}      - "{{VIBE4DOCK_TOOLS_CONTAINER_PORT}}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./:/app
    environment:
      - TARGET_CONTAINER={{VIBE4DOCK_TARGET_CONTAINER}}
{{!PORTS_ONLY}}      - ROOT_SHELL_HOST_PORT={{VIBE4DOCK_ROOT_SHELL_HOST_PORT}}
{{!PORTS_ONLY}}      - APP_SHELL_HOST_PORT={{VIBE4DOCK_APP_SHELL_HOST_PORT}}
{{!PATHS_ONLY}}      - VIBE4DOCK_ROUTING={{VIBE4DOCK_ROUTING}}
{{!PATHS_ONLY}}      - VIBE4DOCK_BASE_PATH_PREFIX={{VIBE4DOCK_BASE_PATH_PREFIX}}
{{!PATHS_ONLY}}      - VIBE4DOCK_BASE_PATH_DASHBOARD={{VIBE4DOCK_BASE_PATH_DASHBOARD}}
{{!PATHS_ONLY}}      - VIBE4DOCK_BASE_PATH_ROOT_SHELL={{VIBE4DOCK_BASE_PATH_ROOT_SHELL}}
{{!PATHS_ONLY}}      - VIBE4DOCK_BASE_PATH_APP_SHELL={{VIBE4DOCK_BASE_PATH_APP_SHELL}}
    restart: unless-stopped
{{!PATHS_ONLY}}  proxy:
{{!PATHS_ONLY}}    image: nginx:alpine
{{!PATHS_ONLY}}    container_name: {{VIBE4DOCK_TARGET_CONTAINER}}-proxy
{{!PATHS_ONLY}}    ports:
{{!PATHS_ONLY}}      - "{{VIBE4DOCK_WEB_HOST_PORT}}:80"
{{!PATHS_ONLY}}    volumes:
{{!PATHS_ONLY}}      - ./docker/proxy/default.conf:/etc/nginx/conf.d/default.conf:ro
{{!PATHS_ONLY}}    depends_on:
{{!PATHS_ONLY}}      - web
{{!PATHS_ONLY}}      - tools
{{!PATHS_ONLY}}    restart: unless-stopped
