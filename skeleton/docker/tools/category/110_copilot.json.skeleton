{
    "categories": [
        {
            "unique_key": "ai-cli",
            "id": "ai-cli",
            "label": "AI CLI",
            "order": 100
        }
    ],
    "tools": [
        {
            "id": "copilot",
            "category": "ai-cli",
            "label": "GitHub Copilot CLI",
            "mounts": [
                "./docker/web/settings/copilot:/home/application/.copilot"
            ],
            "description": "Your AI pair programmer in the terminal.",
            "usage": "",
            "version_regex": "/v?([0-9]+(?:\\.[0-9]+)*)/",
            "dependencies": [],
            "check": "copilot --version 2>/dev/null | grep .",
            "install": "sudo -u application env HOME=/home/application PREFIX=/home/application/.local bash -c 'curl -fsSL https://gh.io/copilot-install | bash' && ln -sf /home/application/.local/bin/copilot /usr/local/bin/copilot",
            "uninstall": "rm -f /usr/local/bin/copilot && sudo -u application env HOME=/home/application bash -c 'rm -f ~/.local/bin/copilot' || true"
        }
    ]
}
