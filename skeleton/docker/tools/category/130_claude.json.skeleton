{
    "categories": [
        {
            "unique_key": "ai-cli",
            "id": "ai-cli",
            "label": "AI CLI",
            "order": 100
        }
    ],
    "tools": [
        {
            "id": "claude",
            "category": "ai-cli",
            "label": "Claude Code",
            "mounts": [
                "./docker/web/settings/claude:/home/application/.claude"
            ],
            "description": "Claude Code is a command-line interface that brings Claude's coding expertise directly to your terminal.",
            "usage": "",
            "version_regex": "/v?([0-9]+(?:\\.[0-9]+)*)/",
            "dependencies": [],
            "check": "claude --version 2>/dev/null | cut -d' ' -f1 | grep .",
            "install": "sudo -u application -H env HOME=/home/application bash -lc 'curl -fsSL https://claude.ai/install.sh | bash' && ln -sf /home/application/.local/bin/claude /usr/local/bin/claude",
            "uninstall": "rm -f /usr/local/bin/claude && sudo -u application -H env HOME=/home/application bash -lc 'rm -f ~/.local/bin/claude && rm -rf ~/.local/share/claude' || true"
        }
    ]
}
