:root {
    --primary: #8ef;
    --primary-dark: #008ba3;
    --primary-dim: rgba(136, 238, 255, 0.1);
    --primary-status-bg: rgba(136, 238, 255, 0.2);
    --primary-status-border: rgba(136, 238, 255, 0.3);
    --original-red: #cd1719;
    --bg-body: #0f1115;
    --bg-body-accent: #172033;
    --bg-card: #181c23;
    --bg-card-hover: #212733;
    --border: #2b3340;
    --border-light: #202733;
    --text: #e0e0e0;
    --text-dim: #aaa;
    --text-white: #fff;
    --text-dark: #555;
    --bg-black: #000;
    --bg-btn-secondary: #444;
    --bg-btn-secondary-hover: #555;
    font-size: 15px;
}

* { box-sizing: border-box; }

html, body {
    margin: 0;
    height: 100%;
    background: var(--bg-body);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, sans-serif;
    line-height: 1.5;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(circle at top, var(--bg-body-accent) 0%, transparent 55%);
}

#app { display: flex; height: 100vh; position: relative; z-index: 1; }

#sidebar {
    width: 250px;
    background: rgba(24, 28, 35, 0.75);
    border-right: 1px solid var(--border);
    padding: 14px 12px;
    overflow-y: auto;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
}

#sidebar.hidden { display: none; }

#brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 2px 4px 14px;
    border-bottom: 1px solid var(--border-light);
    margin-bottom: 14px;
}

#brand svg { width: 48px; height: 48px; flex-shrink: 0; }
#brand .brand-name { font-size: 1.8em; font-weight: bold; color: var(--text-white); letter-spacing: -0.5px; }
#brand .brand-name a { color: inherit; text-decoration: none; }
#brand .brand-name a:hover { text-decoration: underline; }

#new-chat { width: 100%; }

#session-list { list-style: none; margin: 14px 0 0; padding: 0; }

#session-list li {
    padding: 9px 12px;
    border-radius: 8px;
    cursor: pointer;
    color: var(--text-dim);
    font-size: 0.92em;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: background 0.2s, color 0.2s;
}

#session-list li:hover { background: var(--bg-card-hover); color: var(--text); }
#session-list li.active { background: var(--primary-dim); color: var(--primary); }

#chat { flex: 1; display: flex; flex-direction: column; min-width: 0; }

#topbar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    background: rgba(24, 28, 35, 0.75);
}

#session-title { flex: 1; font-weight: bold; color: var(--text-white); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

#messages { flex: 1; overflow-y: auto; padding: 26px 16px; scroll-behavior: smooth; }

.empty-state { color: var(--text-dim); text-align: center; margin-top: 30vh; }

.msg { max-width: 760px; margin: 0 auto 20px; }

.msg .who { font-size: 0.78em; font-weight: bold; color: var(--primary); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.5px; }
.msg.user .who { color: var(--text-dim); }

.msg.user .bubble {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-right: 2px solid var(--primary);
    border-radius: 12px;
    padding: 12px 16px;
    white-space: pre-wrap;
    word-wrap: break-word;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.msg.assistant .bubble { padding: 2px 6px 2px 10px; line-height: 1.6; word-wrap: break-word; border-left: 2px solid var(--text-dim); }

.assistant-error {
    color: #b91c1c;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 8px;
    padding: 8px 10px;
    margin-bottom: 6px;
    font-size: 14px;
    word-break: break-word;
}

.bubble pre {
    background: var(--bg-black);
    padding: 14px 16px;
    border-radius: 12px;
    overflow-x: auto;
    color: #ccc;
    border: 1px solid var(--border);
    line-height: 1.4;
    font-size: 0.85rem;
}

.bubble code {
    color: var(--primary);
    background: var(--primary-dim);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
}

.bubble pre code { background: transparent; padding: 0; color: inherit; }

.bubble p { margin: 0 0 10px; }
.bubble p:last-child { margin-bottom: 0; }
.bubble h1, .bubble h2, .bubble h3, .bubble h4 { margin: 14px 0 8px; line-height: 1.3; color: var(--text-white); }
.bubble h1:first-child, .bubble h2:first-child, .bubble h3:first-child, .bubble h4:first-child { margin-top: 0; }
.bubble h1 { font-size: 1.25em; }
.bubble h2 { font-size: 1.15em; }
.bubble h3 { font-size: 1.05em; }
.bubble h4 { font-size: 1em; }
.bubble ul, .bubble ol { margin: 0 0 10px; padding-left: 22px; }
.bubble ul:last-child, .bubble ol:last-child { margin-bottom: 0; }
.bubble li { margin: 3px 0; }
.bubble blockquote { margin: 0 0 10px; padding: 4px 12px; border-left: 3px solid var(--primary); color: var(--text-dim); }
.bubble blockquote:last-child { margin-bottom: 0; }
.bubble hr { border: none; border-top: 1px solid var(--border); margin: 14px 0; }
.bubble a { color: var(--primary); }
.bubble del { color: var(--text-dim); }
.bubble table { border-collapse: collapse; margin: 0 0 10px; font-size: 0.92em; display: block; overflow-x: auto; max-width: 100%; }
.bubble th, .bubble td { border: 1px solid var(--border); padding: 6px 10px; text-align: left; vertical-align: top; }
.bubble th { background: var(--primary-dim); color: var(--text-white); }
.bubble li.task { list-style: none; }
.bubble li.task input[type="checkbox"] { margin: 0 6px 2px 0; vertical-align: middle; accent-color: var(--primary); }

details.thinking {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin: 10px 0;
    font-size: 0.85rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

details.thinking > summary {
    cursor: pointer;
    padding: 9px 36px 9px 12px;
    color: var(--text-dim);
    user-select: none;
    list-style: none;
    position: relative;
}

details.thinking > summary::before {
    content: "\25B8";
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--primary);
    font-size: 1.05em;
}
details.thinking[open] > summary::before { content: "\25BE"; }

details.thinking .thinking-body { padding: 0 12px 10px; color: var(--text-dim); }

.thinking-entry { border-top: 1px solid var(--border-light); padding: 7px 0; }
.thinking-entry:first-child { border-top: none; }

.thinking-entry .tool-name { color: var(--primary); font-weight: bold; }
.thinking-entry em { color: var(--text-dim); font-style: normal; }

.thinking-entry .tool-cmd {
    font-family: 'Cascadia Code', 'Fira Code', monospace;
    color: var(--text);
    background: var(--bg-black);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 5px 9px;
    margin-top: 4px;
    white-space: pre-wrap;
    word-break: break-all;
}

.thinking-entry .tool-out {
    font-family: 'Cascadia Code', 'Fira Code', monospace;
    white-space: pre-wrap;
    word-break: break-word;
    margin-top: 4px;
    max-height: 240px;
    overflow-y: auto;
    color: #ccc;
}

.pending-box {
    max-width: 760px;
    margin: 0 auto 14px;
    background: var(--bg-card);
    border: 1px solid var(--primary-status-border);
    border-radius: 12px;
    padding: 14px 18px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3), 0 0 0 3px var(--primary-dim);
}

.pending-box .q { font-weight: bold; color: var(--text-white); margin-bottom: 10px; }

#pending {
    display: flex;
    justify-content: center;
    max-width: 760px;
    margin: 0 auto;
    width: 100%;
    padding: 0 16px;
    box-sizing: border-box;
}
.pending-box .opts { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0; }
.pending-box input[type=text] {
    width: 100%;
    background: var(--bg-black);
    color: var(--text-white);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px;
    margin-top: 10px;
    font: inherit;
    box-sizing: border-box;
}
.pending-box input[type=text]:focus { outline: 2px solid var(--primary); outline-offset: 1px; }

.pending-box input[type=text].invalid { border-color: #ff6b6b; outline: 2px solid rgba(255, 107, 107, 0.5); outline-offset: 1px; }

.q-error {
    color: #ff6b6b;
    font-size: 0.8em;
    margin-top: 6px;
}
.pending-box .btn { margin-top: 10px; }
.pending-box .q:not(:first-child) { margin-top: 16px; }

#working {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    max-width: 760px;
    margin: 4px auto 10px;
    padding: 8px 16px;
    width: calc(100% - 32px);
    box-sizing: border-box;
    color: var(--text-dim);
    font-size: 0.85em;
}

#working[hidden] { display: none; }

#question-modal {
    position: fixed;
    inset: 0;
    z-index: 500;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

#question-modal[hidden] { display: none; }

#question-modal-card {
    background: var(--bg-card);
    border: 1px solid var(--primary-status-border);
    border-radius: 14px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6), 0 0 0 3px var(--primary-dim);
    width: min(860px, 94vw);
    height: 90vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

#question-modal-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
}

#question-modal-header h2 { margin: 0; font-size: 1.05em; color: var(--text-white); flex: 1; }

#question-modal-close { font-size: 1.3em; padding: 4px 12px; }

#question-modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 18px;
}

#question-modal-body .pending-box {
    max-width: none;
    margin: 0 0 18px;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    box-shadow: none;
}

#question-modal-body .pending-box .q {
    padding-top: 4px;
    border-top: 1px solid var(--border-light);
}

#question-modal-body .pending-box:first-child .q { border-top: none; padding-top: 0; }


#working .spinner { width: 14px; height: 14px; }

.spinner {
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 3px solid rgba(136, 238, 255, 0.2);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    vertical-align: -2px;
    margin-right: 6px;
}

@keyframes spin { to { transform: rotate(360deg); } }

#composer {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 14px 16px 18px;
    max-width: 792px;
    margin: 0 auto;
    width: 100%;
}

#attach-btn { flex-shrink: 0; padding: 10px 12px; font-size: 1.05em; }

#upload-status {
    max-width: 792px;
    margin: 0 auto;
    width: 100%;
    padding: 0 16px 6px;
    box-sizing: border-box;
    color: var(--text-dim);
    font-size: 0.82em;
}

#drop-overlay {
    position: absolute;
    inset: 0;
    z-index: 400;
    background: rgba(0, 139, 163, 0.25);
    border: 2px dashed var(--primary);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
}

#drop-overlay[hidden] { display: none; }

#drop-overlay .drop-inner {
    background: var(--bg-card);
    border: 1px solid var(--primary-status-border);
    border-radius: 12px;
    padding: 18px 28px;
    font-size: 1.05em;
    color: var(--text-white);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
}

#at-popup {
    position: fixed;
    z-index: 450;
    max-height: 300px;
    overflow-y: auto;
    background: var(--bg-card);
    border: 1px solid var(--primary-status-border);
    border-radius: 10px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6);
}

#at-popup[hidden] { display: none; }

#attach-menu {
    position: fixed;
    z-index: 460;
    min-width: 230px;
    background: var(--bg-card);
    border: 1px solid var(--primary-status-border);
    border-radius: 10px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6);
    overflow: hidden;
}

#attach-menu[hidden] { display: none; }

#attach-menu button {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 12px 16px;
    background: none;
    border: none;
    color: var(--text-white);
    font-size: 0.95em;
    cursor: pointer;
    text-align: left;
}

#attach-menu button:hover, #attach-menu button:active { background: var(--primary-dim); }
#attach-menu .am-icon { flex-shrink: 0; }

.at-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 14px;
    cursor: pointer;
    font-size: 0.9em;
}

.at-item.active, .at-item:hover { background: var(--primary-dim); }
.at-item span { color: var(--text-white); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.at-item em { color: var(--text-dim); font-style: normal; font-size: 0.85em; flex-shrink: 0; }

#cmd-popup {
    position: fixed;
    z-index: 450;
    max-height: 300px;
    overflow-y: auto;
    background: var(--bg-card);
    border: 1px solid var(--primary-status-border);
    border-radius: 10px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.6);
}

#cmd-popup[hidden] { display: none; }

.cmd-item span { flex-shrink: 0; color: var(--primary); font-family: 'Cascadia Code', 'Fira Code', monospace; }
.cmd-item em { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

#prompt {
    flex: 1;
    resize: none;
    background: var(--bg-card);
    color: var(--text-white);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    font: inherit;
    max-height: 180px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
}

#prompt:focus { outline: 2px solid var(--primary); outline-offset: 1px; }
#prompt::placeholder { color: var(--text-dim); }

#agent-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 792px;
    margin: 12px auto 0;
    padding: 0 16px;
    width: 100%;
}

#agent-bar label { color: var(--text-dim); font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.5px; }

#agent-select, #model-select {
    background: var(--bg-card);
    color: var(--text-white);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 5px 8px;
    font: inherit;
    font-size: 0.85em;
    cursor: pointer;
}

#agent-select:focus, #model-select:focus { outline: 2px solid var(--primary); outline-offset: 1px; }

.btn {
    border: none;
    background: var(--bg-btn-secondary);
    color: #eee;
    border-radius: 6px;
    padding: 10px 18px;
    cursor: pointer;
    font-weight: bold;
    font-size: 0.9em;
    transition: opacity 0.2s, background-color 0.2s;
}

.btn.has-desc {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    text-align: left;
}
.btn .opt-desc {
    font-size: 0.82em;
    font-weight: 400;
    line-height: 1.35;
    opacity: 0.75;
    white-space: normal;
}

.btn:hover { opacity: 0.9; }
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-primary { background: var(--primary); color: var(--text-dark); }
.btn-danger { background: var(--original-red); color: var(--text-white); }
.btn-icon { padding: 8px 11px; background: transparent; border: 1px solid var(--border); color: var(--text-dim); }
.btn-icon:hover { background: var(--bg-card-hover); color: var(--text); }

#stop-btn { padding: 8px 14px; font-size: 0.85em; }

#footer {
    border-top: 1px solid var(--border);
    padding: 12px 16px;
    color: var(--text-dim);
    font-size: 0.78em;
    text-align: center;
    background: rgba(24, 28, 35, 0.75);
}

#footer .footer-inner { display: flex; align-items: center; justify-content: center; gap: 10px; }
#footer .footer-logo { width: 20px; height: 20px; flex-shrink: 0; }
#footer .footer-logo svg { width: 100%; height: 100%; display: block; }
#footer strong { color: var(--text); }
#footer a { color: inherit; text-decoration: none; }
#footer a:hover { text-decoration: underline; }

#session-list li { position: relative; padding-right: 28px; }

#session-list .session-label {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

#session-list .session-delete {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: var(--text-dim);
    font-size: 1em;
    line-height: 1;
    padding: 3px 6px;
    border-radius: 5px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s, color 0.15s, background 0.15s;
    font-family: inherit;
}

#session-list li:hover .session-delete { opacity: 1; }
#session-list .session-delete:hover { color: var(--text-white); background: var(--bg-btn-secondary); }
#session-list .session-delete.confirm { color: var(--text-white); background: var(--original-red); opacity: 1; }

* { scrollbar-width: thin; scrollbar-color: var(--border) transparent; }

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: #3d4757; }
::-webkit-scrollbar-corner { background: transparent; }

@media (max-width: 700px) {
    #topbar { position: relative; z-index: 20; }
    #sidebar { position: absolute; z-index: 10; height: 100%; background: var(--bg-card); padding-top: 76px; }
    #sidebar.hidden { display: none; }
}

/* ============================================================
   LANGUAGE SWITCH (de/en)
   ============================================================ */
.lang-switch {
    display: inline-flex;
    border: 1px solid var(--border, #2a2f3a);
    border-radius: 14px;
    overflow: hidden;
    background: transparent;
    flex-shrink: 0;
}

.lang-switch button {
    appearance: none;
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: 11px;
    line-height: 1;
    padding: 6px 10px;
    cursor: pointer;
    opacity: 0.6;
}

.lang-switch button + button {
    border-left: 1px solid var(--border, #2a2f3a);
}

.lang-switch button.active {
    background: var(--primary);
    color: #08131a;
    opacity: 1;
    font-weight: 700;
}
