{
    "categories": [
        {
            "unique_key": "ai-assistants",
            "id": "ai-assistants",
            "label": "AI Assistants",
            "order": 600,
            "menu_group": "addons"
        }
    ],
    "tools": [
        {
            "id": "veronica",
            "category": "ai-assistants",
            "label": "Veronica",
            "description": "WhatsApp-like end-customer chat in front of a headless opencode agent working on the project. End customers log in with a 2-3 character alias and PIN; their chats are tagged [alias] in opencode and initially belong to the user only. No thinking or tool output is shown - just 'Veronica schreibt'.",
            "usage": "",
            "check": "false",
            "install": "true",
            "uninstall": "true",
            "dependencies": [
                "opencode-cli"
            ],
            "config_schema": {
                "fields": [
                    {
                        "key": "port",
                        "label": "Web UI port",
                        "default": "4581",
                        "help_text": "Host port for the Veronica web interface.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "ports.0",
                                "format": "%s:4581",
                                "target_services": [
                                    "veronica"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "username",
                        "required": false,
                        "label": "Username",
                        "default": "",
                        "help_text": "HTTP Basic Auth username for the Veronica UI (site-level protection in front of the alias login). Without username and password Veronica is accessible without authentication.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.VERONICA_USERNAME",
                                "target_services": [
                                    "veronica"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "password",
                        "required": false,
                        "label": "Password",
                        "type": "password",
                        "default": "",
                        "help_text": "HTTP Basic Auth password for the Veronica UI. Protection is only enabled when username and password are both set.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.VERONICA_PASSWORD",
                                "target_services": [
                                    "veronica"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "allow_registration",
                        "required": false,
                        "label": "Allow self-registration",
                        "type": "checkbox",
                        "default": "1",
                        "help_text": "When enabled, visitors can create their own alias/PIN account on the login screen. When disabled, only admins can create users via the in-app user management. The first registered user automatically becomes admin.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.VERONICA_ALLOW_REGISTRATION",
                                "target_services": [
                                    "veronica"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "api_key",
                        "required": false,
                        "label": "Provider API key",
                        "type": "password",
                        "default": "",
                        "help_text": "Optional API key passed to opencode as OPENCODE_API_KEY. Leave empty to run \"opencode auth login\" instead (shared with the OpenCode CLI in the application shell).",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.OPENCODE_API_KEY",
                                "target_services": [
                                    "veronica"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "provider",
                        "required": false,
                        "label": "Provider",
                        "default": "",
                        "help_text": "Optional provider id sent with every prompt (e.g. anthropic, openai, google, opencode). Empty = opencode default.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.OPENCODE_PROVIDER",
                                "target_services": [
                                    "veronica"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "model",
                        "required": false,
                        "label": "Model",
                        "default": "",
                        "help_text": "Optional model id sent with every prompt (e.g. claude-sonnet-4-5). Empty = opencode default.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.OPENCODE_MODEL",
                                "target_services": [
                                    "veronica"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "agent",
                        "required": false,
                        "label": "Agent",
                        "default": "",
                        "help_text": "Optional opencode agent / persona id sent with every prompt (e.g. build, plan or a custom primary agent from ~/.config/opencode/agent/). Empty = no preselection.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.OPENCODE_AGENT",
                                "target_services": [
                                    "veronica"
                                ]
                            }
                        ]
                    }
                ]
            },
            "package_operations": {
                "templates": [
                    {
                        "target": "docker/veronica/Dockerfile",
                        "content_lines": [
                            "FROM debian:bookworm-slim",
                            "",
                            "ENV DEBIAN_FRONTEND=noninteractive",
                            "ENV TERM=xterm-256color",
                            "",
                            "RUN apt-get update \\",
                            "    && apt-get install -y --no-install-recommends \\",
                            "        ca-certificates \\",
                            "        curl \\",
                            "        git \\",
                            "        nginx \\",
                            "        openssl \\",
                            "        php-fpm \\",
                            "        sudo \\",
                            "    && rm -rf /var/lib/apt/lists/* \\",
                            "    && useradd -m -s /bin/bash application",
                            "",
                            "RUN sudo -u application env HOME=/home/application bash -lc 'curl -fsSL https://opencode.ai/install | bash -s --'",
                            "",
                            "COPY start.sh /usr/local/bin/start.sh",
                            "COPY www /var/www/veronica",
                            "COPY php /opt/vibe/php",
                            "RUN chmod +x /usr/local/bin/start.sh \\",
                            "    && rm -f /etc/nginx/sites-enabled/default",
                            "",
                            "EXPOSE 4581",
                            "",
                            "CMD [\"/usr/local/bin/start.sh\"]",
                            ""
                        ]
                    },
                    {
                        "target": "docker/veronica/start.sh",
                        "mode": "0755",
                        "content_lines": [
                            "#!/bin/sh",
                            "set -e",
                            "",
                            "PORT_VALUE=\"${PORT:-4581}\"",
                            "API_PORT=4577",
                            "export PATH=\"/home/application/.opencode/bin:$PATH\"",
                            "",
                            "if [ -n \"${OPENCODE_API_KEY:-}\" ]; then",
                            "    export ANTHROPIC_API_KEY=\"${OPENCODE_API_KEY}\"",
                            "    export OPENAI_API_KEY=\"${OPENCODE_API_KEY}\"",
                            "fi",
                            "",
                            "mkdir -p /home/application/.config/opencode /home/application/.local/share/opencode /home/application/.local/state/opencode",
                            "chown -R application:application /home/application /var/www/veronica",
                            "",
                            "ALLOW_REGISTRATION=\"1\"",
                            "case \"${VERONICA_ALLOW_REGISTRATION:-1}\" in",
                            "    0|false|no|off) ALLOW_REGISTRATION=\"0\" ;;",
                            "esac",
                            "",
                            "cat > /var/www/veronica/config.js <<CFG",
                            "window.CHAT_CONFIG = {",
                            "    provider: \"${OPENCODE_PROVIDER:-}\",",
                            "    model: \"${OPENCODE_MODEL:-}\",",
                            "    agent: \"${OPENCODE_AGENT:-}\",",
                            "    allowRegistration: \"${ALLOW_REGISTRATION}\"",
                            "};",
                            "CFG",
                            "",
                            "ASSET_V=\"$(date +%s)\"",
                            "sed -i \"s/app.js/app.js?v=${ASSET_V}/; s/i18n.js/i18n.js?v=${ASSET_V}/; s/md.js/md.js?v=${ASSET_V}/; s/style.css/style.css?v=${ASSET_V}/; s/config.js/config.js?v=${ASSET_V}/\" /var/www/veronica/index.html",
                            "",
                            "# ----------------------------------------------------------------------------",
                            "# Veronica user JSON DB (server-side; survives rebuilds and browser switches).",
                            "#   VERONICA_BOOTSTRAP_ADMIN            - admin alias",
                            "#   VERONICA_BOOTSTRAP_ADMIN_PIN_HASH   - \"sha256:...\" (raw PIN also accepted)",
                            "#   VERONICA_BOOTSTRAP_USERS            - \"alias:sha256:...,alias:sha256:...\"",
                            "# The file is seeded once on first start; afterwards the UI/API owns it.",
                            "# ----------------------------------------------------------------------------",
                            "VERONICA_USERS_FILE=\"${VERONICA_USERS_FILE:-/data/veronica-users.json}\"",
                            "VDB_DIR=\"$(dirname \"$VERONICA_USERS_FILE\")\"",
                            "mkdir -p \"$VDB_DIR\"",
                            "chown -R application:application \"$VDB_DIR\" 2>/dev/null || true",
                            "",
                            "# The Veronica UI hashes PINs as \"sha256:<sha256('veronica:<alias>:<pin>')>\"",
                            "# (see app.js hashPin()). Raw PINs from the env seeds get the same salted",
                            "# scheme here so seeded accounts can actually log in.",
                            "normalize_pin_hash() {",
                            "    v=\"$1\"; al=\"$2\"",
                            "    case \"$v\" in",
                            "        sha256:*) printf '%s' \"$v\" ;;",
                            "        '') printf '' ;;",
                            "        *) printf 'sha256:%s' \"$(printf 'veronica:%s:%s' \"$al\" \"$v\" | sha256sum | cut -d' ' -f1)\" ;;",
                            "    esac",
                            "}",
                            "",
                            "sanitize_alias() {",
                            "    printf '%s' \"$1\" | tr -cd 'a-zA-Z0-9._-'",
                            "}",
                            "",
                            "if [ ! -f \"$VERONICA_USERS_FILE\" ]; then",
                            "    ADMIN_ALIAS=\"$(sanitize_alias \"${VERONICA_BOOTSTRAP_ADMIN:-}\")\"",
                            "    ADMIN_PIN=\"$(normalize_pin_hash \"${VERONICA_BOOTSTRAP_ADMIN_PIN_HASH:-}\" \"$ADMIN_ALIAS\")\"",
                            "    if [ -n \"$ADMIN_ALIAS\" ] && [ -n \"$ADMIN_PIN\" ]; then",
                            "        {",
                            "            printf '{\\n  \"%s\": {\"pin\": \"%s\", \"createdAt\": %s, \"admin\": true}' \\",
                            "                \"$ADMIN_ALIAS\" \"$ADMIN_PIN\" \"$(date +%s000)\"",
                            "            OLDIFS=\"$IFS\"; IFS=','",
                            "            for entry in ${VERONICA_BOOTSTRAP_USERS:-}; do",
                            "                [ -z \"$entry\" ] && continue",
                            "                ALIAS=\"$(sanitize_alias \"${entry%%:*}\")\"",
                            "                PIN=\"$(normalize_pin_hash \"${entry#*:}\" \"$ALIAS\")\"",
                            "                if [ -z \"$ALIAS\" ] || [ -z \"$PIN\" ] || [ \"$ALIAS\" = \"$ADMIN_ALIAS\" ]; then",
                            "                    continue",
                            "                fi",
                            "                printf ',\\n  \"%s\": {\"pin\": \"%s\", \"createdAt\": %s}' \"$ALIAS\" \"$PIN\" \"$(date +%s000)\"",
                            "            done",
                            "            IFS=\"$OLDIFS\"",
                            "            printf '\\n}\\n'",
                            "        } > \"$VERONICA_USERS_FILE\"",
                            "    else",
                            "        printf '{}\\n' > \"$VERONICA_USERS_FILE\"",
                            "    fi",
                            "fi",
                            "touch \"$VERONICA_USERS_FILE.lock\"",
                            "chown application:application \"$VERONICA_USERS_FILE\" \"$VERONICA_USERS_FILE.lock\" 2>/dev/null || true",
                            "",
                            "# ----------------------------------------------------------------------------",
                            "# php-fpm pool for the user JSON DB API (clear_env=no so the API can read",
                            "# VERONICA_USERS_FILE; the socket is owned by www-data for nginx).",
                            "# ----------------------------------------------------------------------------",
                            "mkdir -p /run/php",
                            "cat > /etc/vibe-php-fpm.conf <<FPM",
                            "[global]",
                            "error_log = /proc/self/fd/2",
                            "daemonize = no",
                            "",
                            "[veronica]",
                            "user = application",
                            "group = application",
                            "listen = /run/php/php-fpm-veronica.sock",
                            "listen.owner = www-data",
                            "listen.group = www-data",
                            "pm = dynamic",
                            "pm.max_children = 10",
                            "pm.start_servers = 2",
                            "pm.min_spare_servers = 1",
                            "pm.max_spare_servers = 3",
                            "catch_workers_output = yes",
                            "clear_env = no",
                            "security.limit_extensions = .php",
                            "php_admin_value[upload_max_filesize] = 100M",
                            "php_admin_value[post_max_size] = 120M",
                            "FPM",
                            "",
                            "PHP_FPM_BIN=\"$(command -v php-fpm8.2 || command -v php-fpm || true)\"",
                            "if [ -n \"$PHP_FPM_BIN\" ]; then",
                            "    \"$PHP_FPM_BIN\" -F -y /etc/vibe-php-fpm.conf &",
                            "else",
                            "    echo \"php-fpm not found - the server-side user DB API is disabled.\" >&2",
                            "fi",
                            "",
                            "if [ -n \"${VERONICA_USERNAME:-}\" ] && [ -n \"${VERONICA_PASSWORD:-}\" ]; then",
                            "    HASH=\"$(openssl passwd -apr1 \"$VERONICA_PASSWORD\")\"",
                            "    printf '%s:%s\\n' \"$VERONICA_USERNAME\" \"$HASH\" > /etc/nginx/veronica.htpasswd",
                            "    printf '    auth_basic \"Veronica 2026-09\";\\n    auth_basic_user_file /etc/nginx/veronica.htpasswd;\\n' > /etc/nginx/veronica-auth.inc",
                            "else",
                            "    echo \"VERONICA_USERNAME/VERONICA_PASSWORD not set - Veronica is accessible without authentication.\" >&2",
                            "    : > /etc/nginx/veronica-auth.inc",
                            "fi",
                            "",
                            "BP=\"${VERONICA_BASE_PATH:-}\"",
                            "if [ -n \"$BP\" ]; then",
                            "    cat > /etc/nginx/conf.d/veronica.conf <<NGINX",
                            "server {",
                            "    listen ${PORT_VALUE};",
                            "    server_name _;",
                            "    absolute_redirect off;",
                            "    client_max_body_size 50m;",
                            "",
                            "    include /etc/nginx/veronica-auth.inc;",
                            "",
                            "    location = ${BP} {",
                            "        return 301 ${BP}/;",
                            "    }",
                            "",
                            "    location = ${BP}/api/users {",
                            "        include /etc/nginx/fastcgi_params;",
                            "        fastcgi_param SCRIPT_FILENAME /opt/vibe/php/veronica-users-api.php;",
                            "        fastcgi_pass unix:/run/php/php-fpm-veronica.sock;",
                            "    }",
                            "",
                            "    location = ${BP}/api/upload {",
                            "        proxy_pass http://tools:8090/api/upload;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "        proxy_set_header X-Real-IP \\$remote_addr;",
                            "        client_max_body_size 200m;",
                            "        proxy_read_timeout 300s;",
                            "        proxy_send_timeout 300s;",
                            "    }",
                            "",
                            "    location = ${BP}/api/upload/list {",
                            "        proxy_pass http://tools:8090/api/upload/list;",
                            "        proxy_set_header Host \\$host;",
                            "    }",
                            "",
                            "    location = ${BP}/models.json {",
                            "        alias /home/application/.local/state/opencode/model.json;",
                            "        default_type application/json;",
                            "        add_header Cache-Control \"no-cache\";",
                            "    }",
                            "",
                            "    location = ${BP}/api/upload/file {",
                            "        proxy_pass http://tools:8090/api/upload/file;",
                            "        proxy_set_header Host \\$host;",
                            "    }",
                            "",
                            "    location ${BP}/api/ {",
                            "        proxy_pass http://127.0.0.1:${API_PORT}/;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "        proxy_set_header X-Real-IP \\$remote_addr;",
                            "        proxy_buffering off;",
                            "        proxy_read_timeout 3600s;",
                            "        proxy_send_timeout 3600s;",
                            "    }",
                            "",
                            "    location ${BP}/ {",
                            "        alias /var/www/veronica/;",
                            "        index index.html;",
                            "        add_header Cache-Control \"no-cache\";",
                            "        try_files \\$uri \\$uri/ ${BP}/index.html;",
                            "    }",
                            "",
                            "    location / {",
                            "        return 404;",
                            "    }",
                            "}",
                            "NGINX",
                            "else",
                            "    cat > /etc/nginx/conf.d/veronica.conf <<NGINX",
                            "server {",
                            "    listen ${PORT_VALUE};",
                            "    server_name _;",
                            "    absolute_redirect off;",
                            "    root /var/www/veronica;",
                            "    index index.html;",
                            "    client_max_body_size 50m;",
                            "",
                            "    include /etc/nginx/veronica-auth.inc;",
                            "",
                            "    location = / {",
                            "        add_header Cache-Control \"no-cache\";",
                            "        try_files /index.html =404;",
                            "    }",
                            "",
                            "    location = /api/users {",
                            "        include /etc/nginx/fastcgi_params;",
                            "        fastcgi_param SCRIPT_FILENAME /opt/vibe/php/veronica-users-api.php;",
                            "        fastcgi_pass unix:/run/php/php-fpm-veronica.sock;",
                            "    }",
                            "",
                            "    location = /api/upload {",
                            "        proxy_pass http://tools:8090/api/upload;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "        proxy_set_header X-Real-IP \\$remote_addr;",
                            "        client_max_body_size 200m;",
                            "        proxy_read_timeout 300s;",
                            "        proxy_send_timeout 300s;",
                            "    }",
                            "",
                            "    location = /api/upload/list {",
                            "        proxy_pass http://tools:8090/api/upload/list;",
                            "        proxy_set_header Host \\$host;",
                            "    }",
                            "",
                            "    location = /models.json {",
                            "        alias /home/application/.local/state/opencode/model.json;",
                            "        default_type application/json;",
                            "        add_header Cache-Control \"no-cache\";",
                            "    }",
                            "",
                            "    location = /api/upload/file {",
                            "        proxy_pass http://tools:8090/api/upload/file;",
                            "        proxy_set_header Host \\$host;",
                            "    }",
                            "",
                            "    location /api/ {",
                            "        proxy_pass http://127.0.0.1:${API_PORT}/;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "        proxy_set_header X-Real-IP \\$remote_addr;",
                            "        proxy_buffering off;",
                            "        proxy_read_timeout 3600s;",
                            "        proxy_send_timeout 3600s;",
                            "    }",
                            "",
                            "    location / {",
                            "        add_header Cache-Control \"no-cache\";",
                            "        try_files \\$uri /index.html;",
                            "    }",
                            "}",
                            "NGINX",
                            "fi",
                            "",
                            "# ----------------------------------------------------------------------------",
                            "# Veronica persona agents (veronica / veronica-plan): assembled from multi-file",
                            "# rule folders so the persona can be extended flexibly (edit the *.md files in",
                            "# persona/veronica*/ on the host, then restart the container):",
                            "#   <opencode-config>/persona/veronica/*.md        - shared persona rules",
                            "#   <opencode-config>/persona/veronica-plan/*.md   - identity + plan restrictions",
                            "# The generated agent files (<opencode-config>/agent/*.md) are rebuilt from",
                            "# these on every container start - do not edit them directly.",
                            "# ----------------------------------------------------------------------------",
                            "VIBE_AGENT_DIR=\"/home/application/.config/opencode/agent\"",
                            "VIBE_PERSONA_DIR=\"/home/application/.config/opencode/persona\"",
                            "mkdir -p \"$VIBE_AGENT_DIR\" \"$VIBE_PERSONA_DIR/veronica\" \"$VIBE_PERSONA_DIR/veronica-plan\"",
                            "",
                            "if [ ! -e \"$VIBE_PERSONA_DIR/veronica/10-identity.md\" ]; then",
                            "cat > \"$VIBE_PERSONA_DIR/veronica/10-identity.md\" <<'PERSONA'",
                            "You are Veronica, the assistant of Vibe4Dock by JBS New Media GmbH, based in Worms, Germany.",
                            "",
                            "- If someone asks in German who you are, answer exactly: \"Ich bin Veronica von Vibe4Dock, dem Assistenten-System von der JBS New Media GmbH in Worms.\"",
                            "- If someone asks in English who you are, answer exactly: \"I am Veronica from Vibe4Dock, the assistant system by JBS New Media GmbH in Worms.\"",
                            "- For any other language, use the English variant.",
                            "PERSONA",
                            "fi",
                            "if [ ! -e \"$VIBE_PERSONA_DIR/veronica/20-style.md\" ]; then",
                            "cat > \"$VIBE_PERSONA_DIR/veronica/20-style.md\" <<'PERSONA'",
                            "- You are friendly, precise and solution-oriented, and you always reply in the language of the question (German or English).",
                            "- You work directly in the users' project directory.",
                            "PERSONA",
                            "fi",
                            "if [ ! -e \"$VIBE_PERSONA_DIR/veronica-plan/10-identity.md\" ]; then",
                            "cat > \"$VIBE_PERSONA_DIR/veronica-plan/10-identity.md\" <<'PERSONA'",
                            "You are Veronica, the assistant of Vibe4Dock by JBS New Media GmbH, based in Worms, Germany.",
                            "",
                            "- If someone asks in German who you are, answer exactly: \"Ich bin Veronica von Vibe4Dock, dem Assistenten-System von der JBS New Media GmbH in Worms.\"",
                            "- If someone asks in English who you are, answer exactly: \"I am Veronica from Vibe4Dock, the assistant system by JBS New Media GmbH in Worms.\"",
                            "- For any other language, use the English variant.",
                            "PERSONA",
                            "fi",
                            "if [ ! -e \"$VIBE_PERSONA_DIR/veronica-plan/20-plan-mode.md\" ]; then",
                            "cat > \"$VIBE_PERSONA_DIR/veronica-plan/20-plan-mode.md\" <<'PERSONA'",
                            "- You are currently in PLAN MODE. In this mode you must NOT create, modify or delete any files - even if asked to.",
                            "- This also applies to shell commands: never use redirections (>, >>), tee, cp, mv, rm, touch, mkdir, sed -i or any other command that writes - shell use in plan mode is strictly read-only.",
                            "- In plan mode you only read and analyze: gather information, answer questions, and provide a concrete implementation plan in your reply.",
                            "- Never end a plan by asking for a confirmation or a reply: no \"sag Bescheid\", no \"weiter\"/\"los\", no \"say the word\", no closing question. The implementation starts when the user switches off the Plan toggle at the top of the chat - the UI then sends the GO automatically. If you mention how to start, say exactly that.",
                            "- Once plan mode is ended (you will notice that you are addressed without the plan-mode context), you work as usual again - then creating and modifying files is allowed again.",
                            "PERSONA",
                            "fi",
                            "if [ ! -e \"$VIBE_PERSONA_DIR/veronica/30-project.md\" ]; then",
                            "cat > \"$VIBE_PERSONA_DIR/veronica/30-project.md\" <<'PERSONA'",
                            "- Your main focus is the project content the user asks for - the whole project directory mounted at /app is your working area.",
                            "- Work in the existing structure instead of replacing it, and do not touch the docker setup unless the user explicitly asks for it.",
                            "- Content must be self-contained: bundle fonts, styles and assets locally (no external CDN dependencies such as Google Fonts).",
                            "PERSONA",
                            "fi",
                            "",
                            "assemble_persona() {",
                            "    agent_name=\"$1\"; agent_desc=\"$2\"; agent_yaml=\"$3\"",
                            "    {",
                            "        echo \"---\"",
                            "        echo \"# GENERATED by start.sh at container start - do not edit.\"",
                            "        echo \"# Extend the persona with files in persona/$agent_name/*.md instead, then restart.\"",
                            "        echo \"description: $agent_desc\"",
                            "        echo \"mode: primary\"",
                            "        echo \"hidden: true\"",
                            "        if [ -n \"$agent_yaml\" ]; then",
                            "            printf '%s\\n' \"$agent_yaml\"",
                            "        fi",
                            "        echo \"---\"",
                            "        echo",
                            "        cat \"$VIBE_PERSONA_DIR/$agent_name\"/*.md 2>/dev/null",
                            "    } > \"$VIBE_AGENT_DIR/$agent_name.md\"",
                            "}",
                            "",
                            "assemble_persona \"veronica\" \"Veronica - Vibe4Dock assistant persona (internal)\" \"\"",
                            "assemble_persona \"veronica-plan\" \"Veronica - Vibe4Dock assistant persona in plan mode, read-only (internal)\" \"tools:",
                            "  write: false",
                            "  edit: false",
                            "  patch: false",
                            "permission:",
                            "  edit: deny",
                            "  bash: deny\"",
                            "",
                            "chown -R application:application \"$VIBE_AGENT_DIR\" \"$VIBE_PERSONA_DIR\" 2>/dev/null || true",
                            "",
                            "sudo -E -u application env HOME=/home/application \\",
                            "    PATH=\"/home/application/.opencode/bin:$PATH\" \\",
                            "    opencode serve --hostname 127.0.0.1 --port \"${API_PORT}\" --print-logs --log-level INFO &",
                            "",
                            "exec nginx -g 'daemon off;'",
                            ""
                        ]
                    },
                    {
                        "target": "docker/veronica/www/index.html",
                        "source": "www/index.html"
                    },
                    {
                        "target": "docker/veronica/www/app.js",
                        "source": "www/app.js"
                    },
                    {
                        "target": "docker/veronica/www/style.css",
                        "source": "www/style.css"
                    },
                    {
                        "target": "docker/veronica/README.md",
                        "content_lines": [
                            "# veronica",
                            "",
                            "This directory is managed by Vibe4Dock and contains configuration for the Veronica addon.",
                            "",
                            "Veronica is a WhatsApp-like end-customer chat in front of a headless `opencode serve`",
                            "instance that works directly on the mounted project directory (`/app`). The bot in the",
                            "chat is called **Veronica**.",
                            "",
                            "## Dependency",
                            "",
                            "- The Veronica addon requires the bundled `opencode-cli` tool (AI CLI category).",
                            "- Install the OpenCode CLI first; Veronica cannot be installed without it and no other",
                            "  agent backend is supported.",
                            "",
                            "## End customers",
                            "",
                            "- End customers log in inside the app with a short **alias (2-3 characters)** and a PIN.",
                            "- Accounts live in a server-side JSON user database (`/data/veronica-users.json` inside",
                            "  the container, mounted at `docker/web/settings/veronica` on the host) - they survive",
                            "  container rebuilds and work across browsers/devices.",
                            "- Every chat a customer starts is created in opencode with a `[alias]` tag in the session",
                            "  title, e.g. `[ab] How is the project going?`.",
                            "- The Veronica UI only lists sessions tagged with the logged-in alias, so chats initially",
                            "  belong to their user only. In the shared opencode state the tag shows whose chat it is.",
                            "- No thinking or tool output is ever shown to customers - while Veronica works they only",
                            "  see `Veronica schreibt` (typing indicator).",
                            "- PINs are stored as salted hashes (`sha256:veronica:<alias>:<pin>`).",
                            "",
                            "## First admin (bootstrap)",
                            "",
                            "Seed the first admin account once via environment variables before the first start",
                            "(the user DB is only seeded when the file does not exist yet):",
                            "",
                            "    VERONICA_BOOTSTRAP_ADMIN=js",
                            "    VERONICA_BOOTSTRAP_ADMIN_PIN_HASH=<sha256:... or raw PIN>",
                            "    VERONICA_BOOTSTRAP_USERS=ab:rawpin,cd:sha256:...   (optional, comma separated)",
                            "",
                            "Afterwards the DB is owned by the UI/API.",
                            "",
                            "## Access",
                            "",
                            "- HTTP Basic Auth is optional and is configured with the `VERONICA_USERNAME` /",
                            "  `VERONICA_PASSWORD` addon settings (site-level protection in front of the app).",
                            "- Without credentials Veronica is accessible without authentication; the alias login",
                            "  still applies.",
                            "- `VERONICA_ALLOW_REGISTRATION` (addon setting \"Allow self-registration\") controls",
                            "  whether visitors can create their own alias/PIN account on the login screen",
                            "  (enabled by default). When disabled, only admins can create users via the",
                            "  in-app user management panel.",
                            "- Admins open the user management (users icon in the sidebar) to list, create, edit",
                            "  (PIN/admin flag) and delete users - changes are persisted server-side via the",
                            "  built-in `/api/users` endpoint (php-fpm, atomic writes with lock file).",
                            "",
                            "## Provider",
                            "",
                            "opencode reads its provider/auth configuration from the shared state directory that is",
                            "also used by the OpenCode CLI in the application shell:",
                            "",
                            "    docker compose exec -u application veronica opencode auth login",
                            "",
                            "The same login also enables the CLI inside this container (shared",
                            "`/home/application/.config/opencode` and `/home/application/.local/share/opencode`).",
                            "",
                            "Optional: set provider, model, and API key in the addon settings",
                            "(`OPENCODE_PROVIDER`, `OPENCODE_MODEL`, `OPENCODE_API_KEY`) to pin the model per request.",
                            "Optional: `OPENCODE_AGENT` preselects an opencode agent / persona for every prompt.",
                            "If no model is selectable (fresh install without auth), the UI shows an explicit",
                            "warning instead of silently failing - OpenCode free-tier models reject API usage",
                            "with a 403 and cannot be used from Veronica.",
                            "",
                            "## Data",
                            "",
                            "- Sessions/auth state: `docker/web/settings/opencode-share` (host, shared with the CLI)",
                            "- Config: `docker/web/settings/opencode` (host, shared with the CLI)",
                            "- User DB: `docker/web/settings/veronica/veronica-users.json` (host)",
                            ""
                        ]
                    },
                    {
                        "target": "docker/veronica/www/i18n.js",
                        "source": "www/i18n.js"
                    },
                    {
                        "target": "docker/veronica/www/md.js",
                        "source": "www/md.js"
                    },
                    {
                        "target": "docker/veronica/www/sw.js",
                        "source": "www/sw.js"
                    },
                    {
                        "target": "docker/veronica/www/manifest.json",
                        "source": "www/manifest.json"
                    },
                    {
                        "target": "docker/veronica/www/icons/logo.svg",
                        "source": "www/icons/logo.svg"
                    },
                    {
                        "target": "docker/veronica/www/icons/icon-192.png",
                        "source": "www/icons/icon-192.png"
                    },
                    {
                        "target": "docker/veronica/www/icons/icon-512.png",
                        "source": "www/icons/icon-512.png"
                    },
                    {
                        "target": "docker/veronica/www/icons/maskable-512.png",
                        "source": "www/icons/maskable-512.png"
                    },
                    {
                        "target": "docker/veronica/www/fonts/inter-latin.woff2",
                        "source": "www/fonts/inter-latin.woff2"
                    },
                    {
                        "target": "docker/veronica/www/fonts/inter-latin-ext.woff2",
                        "source": "www/fonts/inter-latin-ext.woff2"
                    },
                    {
                        "target": "docker/veronica/php/veronica-users-api.php",
                        "source": "php/veronica-users-api.php"
                    }
                ],
                "cleanup_directories": [
                    "docker/veronica"
                ]
            },
            "compose_service": {
                "service": "veronica",
                "definition": {
                    "build": "./docker/veronica",
                    "restart": "unless-stopped",
                    "ports": [
                        "4581:4581"
                    ],
                    "working_dir": "/app",
                    "environment": {
                        "VERONICA_USERNAME": "",
                        "VERONICA_PASSWORD": "",
                        "VERONICA_ALLOW_REGISTRATION": "1",
                        "OPENCODE_API_KEY": "",
                        "OPENCODE_PROVIDER": "",
                        "OPENCODE_MODEL": "",
                        "OPENCODE_AGENT": "",
                        "PORT": "4581",
                        "VERONICA_USERS_FILE": "/data/veronica-users.json",
                        "VERONICA_BOOTSTRAP_ADMIN": "",
                        "VERONICA_BOOTSTRAP_ADMIN_PIN_HASH": "",
                        "VERONICA_BOOTSTRAP_USERS": ""
                    },
                    "volumes": [
                        "./:/app",
                        "./docker/web/settings/opencode:/home/application/.config/opencode",
                        "./docker/web/settings/opencode-share:/home/application/.local/share/opencode",
                        "./docker/web/settings/veronica:/data"
                    ]
                }
            },
            "dashboard_shell": {
                "label": "Veronica",
                "routing": {
                    "path": "veronica",
                    "service": "veronica",
                    "container_port": 4581,
                    "environment": {
                        "VERONICA_BASE_PATH": "{{path}}"
                    },
                    "auth": "cookie"
                },
                "port_field": "port",
                "username_field": "username",
                "password_field": "password",
                "button_label": "Open Veronica",
                "help_title": "Configure Veronica",
                "help_text": "Set username and password in the Addons section, then rebuild the stack to apply changes. The dashboard button opens the Veronica end-customer chat. End customers log in with a 2-3 character alias and PIN; their chats are tagged [alias] in opencode. Provider access is configured once via \"opencode auth login\" (shared with the OpenCode CLI) or with the api_key addon setting.",
                "help_command": "./docker/rebuild.sh"
            }
        }
    ]
}