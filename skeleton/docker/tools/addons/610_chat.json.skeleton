{
    "categories": [
        {
            "unique_key": "ai-assistants",
            "id": "ai-assistants",
            "label": "AI Assistants",
            "order": 600,
            "menu_group": "addons"
        }
    ],
    "tools": [
        {
            "id": "chat",
            "category": "ai-assistants",
            "label": "Chat",
            "description": "ChatGPT-like web UI in front of a headless opencode agent working on the project. Shell activity is shown in a collapsible thinking panel; agent questions and permission requests appear as interactive bubbles.",
            "usage": "",
            "check": "false",
            "install": "true",
            "uninstall": "true",
            "config_schema": {
                "fields": [
                    {
                        "key": "port",
                        "label": "Web UI port",
                        "default": "4580",
                        "help_text": "Host port for the chat web interface.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "ports.0",
                                "format": "%s:4580",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "username",
                        "required": false,
                        "label": "Username",
                        "default": "",
                        "help_text": "HTTP Basic Auth username for the chat UI. Without username and password the chat answers 403 for every request (fail closed).",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.CHAT_USERNAME",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "password",
                        "required": false,
                        "label": "Password",
                        "type": "password",
                        "default": "",
                        "help_text": "HTTP Basic Auth password for the chat UI. Protection is only enabled when username and password are both set.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.CHAT_PASSWORD",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "api_key",
                        "required": false,
                        "label": "Provider API key",
                        "type": "password",
                        "default": "",
                        "help_text": "Optional API key passed to opencode as OPENCODE_API_KEY. Leave empty to run \"opencode auth login\" instead (shared with the OpenCode CLI in the application shell).",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.OPENCODE_API_KEY",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "provider",
                        "required": false,
                        "label": "Provider",
                        "default": "",
                        "help_text": "Optional provider id sent with every prompt (e.g. anthropic, openai, google, opencode). Empty = opencode default.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.OPENCODE_PROVIDER",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "model",
                        "required": false,
                        "label": "Model",
                        "default": "",
                        "help_text": "Optional model id sent with every prompt (e.g. claude-sonnet-4-5). Empty = opencode default.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.OPENCODE_MODEL",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    }
                ]
            },
            "package_operations": {
                "templates": [
                    {
                        "target": "docker/chat/Dockerfile",
                        "content_lines": [
                            "FROM debian:bookworm-slim",
                            "",
                            "ENV DEBIAN_FRONTEND=noninteractive",
                            "ENV TERM=xterm-256color",
                            "",
                            "RUN apt-get update \\",
                            "    && apt-get install -y --no-install-recommends \\",
                            "        ca-certificates \\",
                            "        curl \\",
                            "        git \\",
                            "        nginx \\",
                            "        openssl \\",
                            "        sudo \\",
                            "    && rm -rf /var/lib/apt/lists/* \\",
                            "    && useradd -m -s /bin/bash application",
                            "",
                            "RUN sudo -u application env HOME=/home/application bash -lc 'curl -fsSL https://opencode.ai/install | bash -s --'",
                            "",
                            "COPY start.sh /usr/local/bin/start.sh",
                            "COPY www /var/www/chat",
                            "RUN chmod +x /usr/local/bin/start.sh \\",
                            "    && rm -f /etc/nginx/sites-enabled/default",
                            "",
                            "EXPOSE 4580",
                            "",
                            "CMD [\"/usr/local/bin/start.sh\"]"
                        ]
                    },
                    {
                        "target": "docker/chat/start.sh",
                        "mode": "0755",
                        "content_lines": [
                            "#!/bin/sh",
                            "set -e",
                            "",
                            "PORT_VALUE=\"${PORT:-4580}\"",
                            "API_PORT=4577",
                            "export PATH=\"/home/application/.opencode/bin:$PATH\"",
                            "",
                            "if [ -n \"${OPENCODE_API_KEY:-}\" ]; then",
                            "    export ANTHROPIC_API_KEY=\"${OPENCODE_API_KEY}\"",
                            "    export OPENAI_API_KEY=\"${OPENCODE_API_KEY}\"",
                            "fi",
                            "",
                            "mkdir -p /home/application/.config/opencode /home/application/.local/share/opencode",
                            "chown -R application:application /home/application /var/www/chat",
                            "",
                            "cat > /var/www/chat/config.js <<CFG",
                            "window.CHAT_CONFIG = {",
                            "    provider: \"${OPENCODE_PROVIDER:-}\",",
                            "    model: \"${OPENCODE_MODEL:-}\"",
                            "};",
                            "CFG",
                            "",
                            "if [ -n \"${CHAT_USERNAME:-}\" ] && [ -n \"${CHAT_PASSWORD:-}\" ]; then",
                            "    HASH=\"$(openssl passwd -apr1 \"$CHAT_PASSWORD\")\"",
                            "    printf '%s:%s\\n' \"$CHAT_USERNAME\" \"$HASH\" > /etc/nginx/chat.htpasswd",
                            "    printf '    auth_basic \"Vibe4Dock Chat\";\\n    auth_basic_user_file /etc/nginx/chat.htpasswd;\\n' > /etc/nginx/chat-auth.inc",
                            "else",
                            "    echo \"CHAT_USERNAME/CHAT_PASSWORD not set - access is disabled (fail closed).\" >&2",
                            "    printf '    return 403;\\n' > /etc/nginx/chat-auth.inc",
                            "fi",
                            "",
                            "BP=\"${CHAT_BASE_PATH:-}\"",
                            "if [ -n \"$BP\" ]; then",
                            "    cat > /etc/nginx/conf.d/chat.conf <<NGINX",
                            "server {",
                            "    listen ${PORT_VALUE};",
                            "    server_name _;",
                            "    client_max_body_size 50m;",
                            "",
                            "    include /etc/nginx/chat-auth.inc;",
                            "",
                            "    location = ${BP} {",
                            "        return 301 ${BP}/;",
                            "    }",
                            "",
                            "    location ${BP}/api/ {",
                            "        proxy_pass http://127.0.0.1:${API_PORT}/;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "        proxy_set_header X-Real-IP \\$remote_addr;",
                            "        proxy_buffering off;",
                            "        proxy_read_timeout 3600s;",
                            "        proxy_send_timeout 3600s;",
                            "    }",
                            "",
                            "    location ${BP}/ {",
                            "        alias /var/www/chat/;",
                            "        index index.html;",
                            "        try_files \\$uri \\$uri/ ${BP}/index.html;",
                            "    }",
                            "",
                            "    location / {",
                            "        return 404;",
                            "    }",
                            "}",
                            "NGINX",
                            "else",
                            "    cat > /etc/nginx/conf.d/chat.conf <<NGINX",
                            "server {",
                            "    listen ${PORT_VALUE};",
                            "    server_name _;",
                            "    root /var/www/chat;",
                            "    index index.html;",
                            "    client_max_body_size 50m;",
                            "",
                            "    include /etc/nginx/chat-auth.inc;",
                            "",
                            "    location = / {",
                            "        try_files /index.html =404;",
                            "    }",
                            "",
                            "    location /api/ {",
                            "        proxy_pass http://127.0.0.1:${API_PORT}/;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "        proxy_set_header X-Real-IP \\$remote_addr;",
                            "        proxy_buffering off;",
                            "        proxy_read_timeout 3600s;",
                            "        proxy_send_timeout 3600s;",
                            "    }",
                            "",
                            "    location / {",
                            "        try_files \\$uri /index.html;",
                            "    }",
                            "}",
                            "NGINX",
                            "fi",
                            "",
                            "sudo -E -u application env HOME=/home/application \\",
                            "    PATH=\"/home/application/.opencode/bin:$PATH\" \\",
                            "    opencode serve --hostname 127.0.0.1 --port \"${API_PORT}\" --print-logs --log-level INFO &",
                            "",
                            "exec nginx -g 'daemon off;'"
                        ]
                    },
                    {
                        "target": "docker/chat/www/index.html",
                        "content_lines": [
                            "<!doctype html>",
                            "<html lang=\"de\">",
                            "<head>",
                            "<meta charset=\"utf-8\">",
                            "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
                            "<title>Vibe4Dock Chat</title>",
                            "<link rel=\"stylesheet\" href=\"style.css\">",
                            "</head>",
                            "<body>",
                            "<div id=\"app\">",
                            "    <aside id=\"sidebar\">",
                            "        <button id=\"new-chat\" class=\"btn btn-primary\">+ Neuer Chat</button>",
                            "        <ul id=\"session-list\"></ul>",
                            "    </aside>",
                            "    <main id=\"chat\">",
                            "        <header id=\"topbar\">",
                            "            <button id=\"toggle-sidebar\" class=\"btn btn-icon\" title=\"Seitenleiste\">&#9776;</button>",
                            "            <span id=\"session-title\">Chat</span>",
                            "            <button id=\"stop-btn\" class=\"btn btn-danger\" hidden>&#9632; Stop</button>",
                            "        </header>",
                            "        <div id=\"messages\">",
                            "            <div class=\"empty-state\">Stelle eine Frage &ndash; der Agent arbeitet direkt im Projektverzeichnis.</div>",
                            "        </div>",
                            "        <div id=\"pending\"></div>",
                            "        <form id=\"composer\">",
                            "            <textarea id=\"prompt\" rows=\"1\" placeholder=\"Prompt &hellip; (Enter senden, Shift+Enter Zeilenumbruch)\"></textarea>",
                            "            <button type=\"submit\" id=\"send-btn\" class=\"btn btn-primary\">Senden</button>",
                            "        </form>",
                            "    </main>",
                            "</div>",
                            "<script src=\"config.js\"></script>",
                            "<script src=\"app.js\"></script>",
                            "</body>",
                            "</html>"
                        ]
                    },
                    {
                        "target": "docker/chat/www/app.js",
                        "content_lines": [
                            "/* Vibe4Dock Chat - vanilla JS frontend for a headless opencode server. */",
                            "(function () {",
                            "    'use strict';",
                            "",
                            "    var state = {",
                            "        sessions: [],",
                            "        sessionId: null,",
                            "        sessionTitle: '',",
                            "        generating: false,",
                            "        lastRendered: null,",
                            "        pendingQuestions: [],",
                            "        pendingPermissions: []",
                            "    };",
                            "",
                            "    var el = {",
                            "        messages: document.getElementById('messages'),",
                            "        pending: document.getElementById('pending'),",
                            "        prompt: document.getElementById('prompt'),",
                            "        composer: document.getElementById('composer'),",
                            "        sendBtn: document.getElementById('send-btn'),",
                            "        stopBtn: document.getElementById('stop-btn'),",
                            "        sessionList: document.getElementById('session-list'),",
                            "        sessionTitle: document.getElementById('session-title'),",
                            "        newChat: document.getElementById('new-chat'),",
                            "        sidebar: document.getElementById('sidebar'),",
                            "        toggleSidebar: document.getElementById('toggle-sidebar')",
                            "    };",
                            "",
                            "    function api(method, path, body) {",
                            "        return fetch('/api' + path, {",
                            "            method: method,",
                            "            headers: body ? { 'Content-Type': 'application/json' } : undefined,",
                            "            body: body ? JSON.stringify(body) : undefined",
                            "        }).then(function (r) {",
                            "            if (!r.ok) { throw new Error('HTTP ' + r.status + ' on ' + path); }",
                            "            var ct = r.headers.get('content-type') || '';",
                            "            return ct.indexOf('json') !== -1 ? r.json() : r.text();",
                            "        });",
                            "    }",
                            "",
                            "    function esc(s) {",
                            "        return String(s == null ? '' : s)",
                            "            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')",
                            "            .replace(/\"/g, '&quot;');",
                            "    }",
                            "",
                            "    function md(text) {",
                            "        var parts = String(text == null ? '' : text).split(/```/);",
                            "        var out = '';",
                            "        for (var i = 0; i < parts.length; i++) {",
                            "            if (i % 2 === 1) {",
                            "                var block = parts[i].replace(/^[a-zA-Z0-9_+-]*\\n/, '');",
                            "                out += '<pre><code>' + esc(block) + '</code></pre>';",
                            "            } else {",
                            "                var seg = esc(parts[i]);",
                            "                seg = seg.replace(/`([^`\\n]+)`/g, '<code>$1</code>');",
                            "                seg = seg.replace(/\\*\\*([^*\\n]+)\\*\\*/g, '<strong>$1</strong>');",
                            "                out += seg;",
                            "            }",
                            "        }",
                            "        return out;",
                            "    }",
                            "",
                            "    function toolSummary(part) {",
                            "        var st = part.state || {};",
                            "        var input = st.input || {};",
                            "        var lines = [];",
                            "        var name = part.tool || 'tool';",
                            "        var status = st.status || 'pending';",
                            "        var head = '<span class=\"tool-name\">' + esc(name) + '</span> <em>(' + esc(status) + ')</em>';",
                            "        lines.push(head);",
                            "        if (input.command || input.cmd || input.description) {",
                            "            lines.push('<div class=\"tool-cmd\">' + esc(input.command || input.cmd || input.description) + '</div>');",
                            "        } else if (input.filePath || input.path) {",
                            "            lines.push('<div class=\"tool-cmd\">' + esc(input.filePath || input.path) + '</div>');",
                            "        }",
                            "        if (status === 'completed' || status === 'error') {",
                            "            var out = '';",
                            "            if (typeof st.output === 'string') { out = st.output; }",
                            "            else if (st.metadata && typeof st.metadata.output === 'string') { out = st.metadata.output; }",
                            "            if (out) { lines.push('<div class=\"tool-out\">' + esc(out.slice(0, 4000)) + '</div>'); }",
                            "        }",
                            "        return '<div class=\"thinking-entry\">' + lines.join('') + '</div>';",
                            "    }",
                            "",
                            "    function renderMessage(m) {",
                            "        var info = m.info || m;",
                            "        var role = info.role || 'user';",
                            "        var parts = m.parts || [];",
                            "        var wrap = document.createElement('div');",
                            "        wrap.className = 'msg ' + (role === 'user' ? 'user' : 'assistant');",
                            "",
                            "        var who = document.createElement('div');",
                            "        who.className = 'who';",
                            "        who.textContent = role === 'user' ? 'Du' : 'opencode';",
                            "        wrap.appendChild(who);",
                            "",
                            "        var answer = document.createElement('div');",
                            "        answer.className = 'bubble';",
                            "",
                            "        var thinking = null;",
                            "        var thinkingBody = null;",
                            "        var thinkingCount = 0;",
                            "",
                            "        for (var i = 0; i < parts.length; i++) {",
                            "            var p = parts[i];",
                            "            if (p.type === 'text' && p.text) {",
                            "                answer.insertAdjacentHTML('beforeend', md(p.text));",
                            "            } else if (p.type === 'reasoning' && p.text) {",
                            "                ensureThinking();",
                            "                thinkingBody.insertAdjacentHTML('beforeend', '<div class=\"thinking-entry\">' + md(p.text) + '</div>');",
                            "                thinkingCount++;",
                            "            } else if (p.type === 'tool') {",
                            "                ensureThinking();",
                            "                thinkingBody.insertAdjacentHTML('beforeend', toolSummary(p));",
                            "                thinkingCount++;",
                            "            }",
                            "        }",
                            "",
                            "        function ensureThinking() {",
                            "            if (thinking) { return; }",
                            "            thinking = document.createElement('details');",
                            "            thinking.className = 'thinking';",
                            "            var summary = document.createElement('summary');",
                            "            summary.innerHTML = '<span class=\"spinner\"></span>Denken &amp; Werkzeuge';",
                            "            thinking.appendChild(summary);",
                            "            thinkingBody = document.createElement('div');",
                            "            thinkingBody.className = 'thinking-body';",
                            "            thinking.appendChild(thinkingBody);",
                            "        }",
                            "",
                            "        if (thinking) {",
                            "            var summary = thinking.querySelector('summary');",
                            "            summary.innerHTML = (state.generating ? '<span class=\"spinner\"></span>' : '') +",
                            "                'Denken &amp; Werkzeuge (' + thinkingCount + ')';",
                            "            if (state.generating && thinkingCount > 0) { thinking.open = true; }",
                            "            wrap.appendChild(thinking);",
                            "        }",
                            "        if (answer.childNodes.length) { wrap.appendChild(answer); }",
                            "        return wrap;",
                            "    }",
                            "",
                            "    function isComplete(m) {",
                            "        var info = m.info || m;",
                            "        var t = info.time || {};",
                            "        return !!(t.completed);",
                            "    }",
                            "",
                            "    function render(messages) {",
                            "        var list = (messages || []).filter(function (m) {",
                            "            var info = m.info || m;",
                            "            return info.role === 'user' || info.role === 'assistant';",
                            "        });",
                            "        el.messages.innerHTML = '';",
                            "        if (!list.length) {",
                            "            el.messages.innerHTML = '<div class=\"empty-state\">Stelle eine Frage &ndash; der Agent arbeitet direkt im Projektverzeichnis.</div>';",
                            "            return;",
                            "        }",
                            "        list.forEach(function (m) { el.messages.appendChild(renderMessage(m)); });",
                            "        el.messages.scrollTop = el.messages.scrollHeight;",
                            "    }",
                            "",
                            "    function renderPending() {",
                            "        el.pending.innerHTML = '';",
                            "        state.pendingQuestions.forEach(function (q) {",
                            "            var box = document.createElement('div');",
                            "            box.className = 'pending-box';",
                            "            var title = document.createElement('div');",
                            "            title.className = 'q';",
                            "            title.textContent = 'R\\u00fcckfrage: ' + (q.question || q.message || q.title || 'Der Agent ben\\u00f6tigt eine Eingabe.');",
                            "            box.appendChild(title);",
                            "",
                            "            var opts = q.options || q.choices || [];",
                            "            if (opts.length) {",
                            "                var optRow = document.createElement('div');",
                            "                optRow.className = 'opts';",
                            "                opts.forEach(function (o) {",
                            "                    var label = typeof o === 'string' ? o : (o.label || o.value || JSON.stringify(o));",
                            "                    var b = document.createElement('button');",
                            "                    b.className = 'btn';",
                            "                    b.textContent = label;",
                            "                    b.addEventListener('click', function () { answerQuestion(q, label); });",
                            "                    optRow.appendChild(b);",
                            "                });",
                            "                box.appendChild(optRow);",
                            "            }",
                            "",
                            "            var form = document.createElement('div');",
                            "            var input = document.createElement('input');",
                            "            input.type = 'text';",
                            "            input.placeholder = 'Antwort schreiben \\u2026';",
                            "            var send = document.createElement('button');",
                            "            send.className = 'btn btn-primary';",
                            "            send.textContent = 'Antworten';",
                            "            send.addEventListener('click', function () { answerQuestion(q, input.value); });",
                            "            form.appendChild(input);",
                            "            form.appendChild(send);",
                            "            box.appendChild(form);",
                            "            el.pending.appendChild(box);",
                            "        });",
                            "",
                            "        state.pendingPermissions.forEach(function (p) {",
                            "            var box = document.createElement('div');",
                            "            box.className = 'pending-box';",
                            "            var title = document.createElement('div');",
                            "            title.className = 'q';",
                            "            title.textContent = 'Freigabe: ' + (p.type || p.permission || 'Aktion') + ' ' + (p.title || '');",
                            "            box.appendChild(title);",
                            "            var opts = document.createElement('div');",
                            "            opts.className = 'opts';",
                            "            ['allow', 'deny'].forEach(function (v) {",
                            "                var b = document.createElement('button');",
                            "                b.className = 'btn ' + (v === 'deny' ? 'btn-danger' : 'btn-primary');",
                            "                b.textContent = v === 'allow' ? 'Erlauben' : 'Ablehnen';",
                            "                b.addEventListener('click', function () { answerPermission(p, v); });",
                            "                opts.appendChild(b);",
                            "            });",
                            "            box.appendChild(opts);",
                            "            el.pending.appendChild(box);",
                            "        });",
                            "    }",
                            "",
                            "    function answerQuestion(q, text) {",
                            "        if (!text) { return; }",
                            "        var id = q.id || q.requestID;",
                            "        api('POST', '/question/' + encodeURIComponent(id) + '/reply', { answer: text })",
                            "            .catch(function () {",
                            "                return api('POST', '/question/' + encodeURIComponent(id) + '/reply', { response: text });",
                            "            })",
                            "            .then(refresh);",
                            "    }",
                            "",
                            "    function answerPermission(p, v) {",
                            "        var sid = p.sessionID || state.sessionId;",
                            "        var pid = p.id || p.permissionID;",
                            "        api('POST', '/session/' + encodeURIComponent(sid) + '/permissions/' + encodeURIComponent(pid), { response: v })",
                            "            .then(refresh)",
                            "            .catch(function () {});",
                            "    }",
                            "",
                            "    function loadSessions() {",
                            "        return api('GET', '/session').then(function (sessions) {",
                            "            state.sessions = (sessions || []).filter(function (s) { return !s.parentID; });",
                            "            el.sessionList.innerHTML = '';",
                            "            state.sessions.forEach(function (s) {",
                            "                var li = document.createElement('li');",
                            "                li.textContent = s.title || s.id;",
                            "                if (s.id === state.sessionId) { li.className = 'active'; }",
                            "                li.addEventListener('click', function () { selectSession(s.id); });",
                            "                el.sessionList.appendChild(li);",
                            "            });",
                            "        });",
                            "    }",
                            "",
                            "    function refresh() {",
                            "        var jobs = [loadSessions()];",
                            "        if (state.sessionId) {",
                            "            jobs.push(api('GET', '/session/' + state.sessionId + '/message').then(function (msgs) {",
                            "                var wasGenerating = state.generating;",
                            "                state.generating = (msgs || []).some(function (m) {",
                            "                    var info = m.info || m;",
                            "                    return info.role === 'assistant' && !(info.time && info.time.completed);",
                            "                });",
                            "                if (wasGenerating !== state.generating || !state.lastRendered || JSON.stringify(msgs).length !== state.lastRendered) {",
                            "                    render(msgs);",
                            "                    state.lastRendered = JSON.stringify(msgs).length;",
                            "                }",
                            "                updateControls();",
                            "            }));",
                            "            jobs.push(api('GET', '/question').then(function (qs) {",
                            "                state.pendingQuestions = (qs || []).filter(function (q) {",
                            "                    return !q.sessionID || q.sessionID === state.sessionId;",
                            "                });",
                            "                renderPending();",
                            "            }).catch(function () { state.pendingQuestions = []; }));",
                            "            jobs.push(api('GET', '/session/' + state.sessionId + '/permission').then(function (ps) {",
                            "                var list = Array.isArray(ps) ? ps : ((ps && ps.permissions) || []);",
                            "                state.pendingPermissions = list;",
                            "                renderPending();",
                            "            }).catch(function () { state.pendingPermissions = []; }));",
                            "        }",
                            "        return Promise.all(jobs.map(function (p) { return p.catch(function () {}); }));",
                            "    }",
                            "",
                            "    function updateControls() {",
                            "        el.stopBtn.hidden = !state.generating;",
                            "        el.sendBtn.disabled = state.generating;",
                            "    }",
                            "",
                            "    function selectSession(id) {",
                            "        state.sessionId = id;",
                            "        state.lastRendered = null;",
                            "        var s = state.sessions.find(function (x) { return x.id === id; });",
                            "        el.sessionTitle.textContent = (s && (s.title || s.id)) || 'Chat';",
                            "        refresh().then(function () {",
                            "            el.sessionList.querySelectorAll('li').forEach(function (li) { li.classList.remove('active'); });",
                            "        });",
                            "    }",
                            "",
                            "    function newChat() {",
                            "        api('POST', '/session', {}).then(function (s) {",
                            "            state.sessionId = s.id;",
                            "            state.sessionTitle = s.title || 'Neuer Chat';",
                            "            el.sessionTitle.textContent = state.sessionTitle;",
                            "            state.lastRendered = null;",
                            "            render([]);",
                            "            return loadSessions();",
                            "        }).catch(function (e) {",
                            "            el.messages.innerHTML = '<div class=\"empty-state\">Konnte keinen Chat anlegen: ' + esc(e.message) + '</div>';",
                            "        });",
                            "    }",
                            "",
                            "    function send(text) {",
                            "        if (!text || state.generating) { return; }",
                            "        var body = { parts: [{ type: 'text', text: text }] };",
                            "        if (window.CHAT_CONFIG && window.CHAT_CONFIG.provider && window.CHAT_CONFIG.model) {",
                            "            body.providerID = window.CHAT_CONFIG.provider;",
                            "            body.modelID = window.CHAT_CONFIG.model;",
                            "        }",
                            "        var ensure = state.sessionId",
                            "            ? Promise.resolve()",
                            "            : api('POST', '/session', {}).then(function (s) { state.sessionId = s.id; });",
                            "        ensure.then(function () {",
                            "            el.prompt.value = '';",
                            "            el.prompt.style.height = 'auto';",
                            "            state.generating = true;",
                            "            updateControls();",
                            "            return api('POST', '/session/' + state.sessionId + '/prompt_async', body);",
                            "        }).then(function () {",
                            "            return refresh();",
                            "        }).catch(function (e) {",
                            "            state.generating = false;",
                            "            updateControls();",
                            "            el.pending.innerHTML = '<div class=\"pending-box\"><div class=\"q\">Fehler: ' + esc(e.message) +",
                            "                '</div>Hinweis: Ist ein Provider konfiguriert? In der Application Shell oder hier im Container: <code>opencode auth login</code></div>';",
                            "        });",
                            "    }",
                            "",
                            "    el.composer.addEventListener('submit', function (e) {",
                            "        e.preventDefault();",
                            "        send(el.prompt.value.trim());",
                            "    });",
                            "",
                            "    el.prompt.addEventListener('keydown', function (e) {",
                            "        if (e.key === 'Enter' && !e.shiftKey) {",
                            "            e.preventDefault();",
                            "            send(el.prompt.value.trim());",
                            "        }",
                            "    });",
                            "",
                            "    el.prompt.addEventListener('input', function () {",
                            "        el.prompt.style.height = 'auto';",
                            "        el.prompt.style.height = Math.min(el.prompt.scrollHeight, 180) + 'px';",
                            "    });",
                            "",
                            "    el.stopBtn.addEventListener('click', function () {",
                            "        if (state.sessionId) { api('POST', '/session/' + state.sessionId + '/abort', {}).then(refresh).catch(function () {}); }",
                            "    });",
                            "",
                            "    el.newChat.addEventListener('click', newChat);",
                            "",
                            "    el.toggleSidebar.addEventListener('click', function () {",
                            "        el.sidebar.classList.toggle('hidden');",
                            "    });",
                            "",
                            "    refresh().then(function () {",
                            "        if (!state.sessionId && state.sessions.length) {",
                            "            selectSession(state.sessions[0].id);",
                            "        }",
                            "    });",
                            "    setInterval(refresh, 1500);",
                            "})();"
                        ]
                    },
                    {
                        "target": "docker/chat/www/style.css",
                        "content_lines": [
                            ":root {",
                            "    --bg: #212121;",
                            "    --bg-side: #171717;",
                            "    --bg-bubble-user: #2f2f2f;",
                            "    --bg-bubble-assistant: transparent;",
                            "    --bg-thinking: #1a1a1a;",
                            "    --border: #333;",
                            "    --text: #ececec;",
                            "    --text-dim: #9a9a9a;",
                            "    --accent: #10a37f;",
                            "    --danger: #ef4444;",
                            "    font-size: 15px;",
                            "}",
                            "",
                            "* { box-sizing: border-box; }",
                            "",
                            "html, body {",
                            "    margin: 0;",
                            "    height: 100%;",
                            "    background: var(--bg);",
                            "    color: var(--text);",
                            "    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;",
                            "}",
                            "",
                            "#app { display: flex; height: 100vh; }",
                            "",
                            "#sidebar {",
                            "    width: 240px;",
                            "    background: var(--bg-side);",
                            "    border-right: 1px solid var(--border);",
                            "    padding: 12px;",
                            "    overflow-y: auto;",
                            "    flex-shrink: 0;",
                            "}",
                            "",
                            "#sidebar.hidden { display: none; }",
                            "",
                            "#session-list { list-style: none; margin: 12px 0 0; padding: 0; }",
                            "",
                            "#session-list li {",
                            "    padding: 8px 10px;",
                            "    border-radius: 8px;",
                            "    cursor: pointer;",
                            "    color: var(--text-dim);",
                            "    white-space: nowrap;",
                            "    overflow: hidden;",
                            "    text-overflow: ellipsis;",
                            "}",
                            "",
                            "#session-list li:hover { background: var(--bg-bubble-user); color: var(--text); }",
                            "#session-list li.active { background: var(--bg-bubble-user); color: var(--text); }",
                            "",
                            "#chat { flex: 1; display: flex; flex-direction: column; min-width: 0; }",
                            "",
                            "#topbar {",
                            "    display: flex;",
                            "    align-items: center;",
                            "    gap: 10px;",
                            "    padding: 10px 16px;",
                            "    border-bottom: 1px solid var(--border);",
                            "    background: var(--bg-side);",
                            "}",
                            "",
                            "#session-title { flex: 1; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }",
                            "",
                            "#messages { flex: 1; overflow-y: auto; padding: 24px 16px; scroll-behavior: smooth; }",
                            "",
                            ".empty-state { color: var(--text-dim); text-align: center; margin-top: 30vh; }",
                            "",
                            ".msg { max-width: 760px; margin: 0 auto 18px; }",
                            "",
                            ".msg .who { font-size: 0.8rem; color: var(--text-dim); margin-bottom: 4px; }",
                            "",
                            ".msg.user .bubble {",
                            "    background: var(--bg-bubble-user);",
                            "    border-radius: 14px;",
                            "    padding: 12px 16px;",
                            "    white-space: pre-wrap;",
                            "    word-wrap: break-word;",
                            "}",
                            "",
                            ".msg.assistant .bubble { padding: 4px 4px; line-height: 1.6; word-wrap: break-word; }",
                            "",
                            ".bubble pre {",
                            "    background: #0d0d0d;",
                            "    border: 1px solid var(--border);",
                            "    border-radius: 8px;",
                            "    padding: 10px 12px;",
                            "    overflow-x: auto;",
                            "    font-size: 0.85rem;",
                            "}",
                            "",
                            ".bubble code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }",
                            "",
                            "details.thinking {",
                            "    background: var(--bg-thinking);",
                            "    border: 1px solid var(--border);",
                            "    border-radius: 10px;",
                            "    margin: 8px 0;",
                            "    font-size: 0.85rem;",
                            "}",
                            "",
                            "details.thinking > summary {",
                            "    cursor: pointer;",
                            "    padding: 8px 12px;",
                            "    color: var(--text-dim);",
                            "    user-select: none;",
                            "    list-style: none;",
                            "}",
                            "",
                            "details.thinking > summary::before { content: \"\\25B8 \"; }",
                            "details.thinking[open] > summary::before { content: \"\\25BE \"; }",
                            "",
                            "details.thinking .thinking-body { padding: 0 12px 10px; color: var(--text-dim); }",
                            "",
                            ".thinking-entry { border-top: 1px solid var(--border); padding: 6px 0; }",
                            ".thinking-entry:first-child { border-top: none; }",
                            "",
                            ".thinking-entry .tool-name { color: var(--accent); font-weight: 600; }",
                            ".thinking-entry .tool-cmd {",
                            "    font-family: ui-monospace, Menlo, Consolas, monospace;",
                            "    color: var(--text);",
                            "    background: #0d0d0d;",
                            "    border-radius: 6px;",
                            "    padding: 4px 8px;",
                            "    margin-top: 4px;",
                            "    white-space: pre-wrap;",
                            "    word-break: break-all;",
                            "}",
                            ".thinking-entry .tool-out {",
                            "    font-family: ui-monospace, Menlo, Consolas, monospace;",
                            "    white-space: pre-wrap;",
                            "    word-break: break-word;",
                            "    margin-top: 4px;",
                            "    max-height: 240px;",
                            "    overflow-y: auto;",
                            "}",
                            "",
                            ".spinner {",
                            "    display: inline-block;",
                            "    width: 12px;",
                            "    height: 12px;",
                            "    border: 2px solid var(--text-dim);",
                            "    border-top-color: transparent;",
                            "    border-radius: 50%;",
                            "    animation: spin 0.8s linear infinite;",
                            "    vertical-align: -2px;",
                            "    margin-right: 6px;",
                            "}",
                            "",
                            "@keyframes spin { to { transform: rotate(360deg); } }",
                            "",
                            ".pending-box {",
                            "    max-width: 760px;",
                            "    margin: 0 auto 12px;",
                            "    background: var(--bg-thinking);",
                            "    border: 1px solid var(--accent);",
                            "    border-radius: 12px;",
                            "    padding: 12px 16px;",
                            "}",
                            "",
                            ".pending-box .q { font-weight: 600; margin-bottom: 8px; }",
                            ".pending-box .opts { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }",
                            ".pending-box input[type=text] {",
                            "    width: 100%;",
                            "    background: var(--bg);",
                            "    color: var(--text);",
                            "    border: 1px solid var(--border);",
                            "    border-radius: 8px;",
                            "    padding: 8px 10px;",
                            "    margin-top: 8px;",
                            "}",
                            "",
                            "#composer {",
                            "    display: flex;",
                            "    gap: 10px;",
                            "    padding: 12px 16px 16px;",
                            "    max-width: 792px;",
                            "    margin: 0 auto;",
                            "    width: 100%;",
                            "}",
                            "",
                            "#prompt {",
                            "    flex: 1;",
                            "    resize: none;",
                            "    background: var(--bg-bubble-user);",
                            "    color: var(--text);",
                            "    border: 1px solid var(--border);",
                            "    border-radius: 14px;",
                            "    padding: 12px 14px;",
                            "    font: inherit;",
                            "    max-height: 180px;",
                            "}",
                            "",
                            "#prompt:focus { outline: 1px solid var(--accent); }",
                            "",
                            ".btn {",
                            "    border: 1px solid var(--border);",
                            "    background: var(--bg-bubble-user);",
                            "    color: var(--text);",
                            "    border-radius: 10px;",
                            "    padding: 8px 14px;",
                            "    cursor: pointer;",
                            "    font: inherit;",
                            "}",
                            "",
                            ".btn:disabled { opacity: 0.5; cursor: not-allowed; }",
                            ".btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }",
                            ".btn-danger { background: var(--danger); border-color: var(--danger); color: #fff; }",
                            ".btn-icon { padding: 8px 10px; }",
                            "",
                            "@media (max-width: 700px) {",
                            "    #sidebar { position: absolute; z-index: 10; height: 100%; }",
                            "    #sidebar.hidden { display: none; }",
                            "}"
                        ]
                    },
                    {
                        "target": "docker/chat/README.md",
                        "content_lines": [
                            "# chat",
                            "",
                            "This directory is managed by Vibe4Dock and contains configuration for the chat addon.",
                            "",
                            "The chat addon exposes a ChatGPT-like web UI in front of a headless `opencode serve`",
                            "instance that works directly on the mounted project directory (`/app`).",
                            "",
                            "## Access",
                            "",
                            "- HTTP Basic Auth is configured with the `CHAT_USERNAME` / `CHAT_PASSWORD` addon settings.",
                            "- Without credentials the nginx front answers 403 for every request (fail closed).",
                            "",
                            "## Provider",
                            "",
                            "opencode reads its provider/auth configuration from the shared state directory that is",
                            "also used by the OpenCode CLI in the application shell:",
                            "",
                            "    docker compose exec -u application chat opencode auth login",
                            "",
                            "The same login also enables the CLI inside the web container (shared",
                            "`/home/application/.config/opencode` and `/home/application/.local/share/opencode`).",
                            "",
                            "Optional: set provider, model, and API key in the addon settings",
                            "(`OPENCODE_PROVIDER`, `OPENCODE_MODEL`, `OPENCODE_API_KEY`) to pin the model per request.",
                            "",
                            "## Data",
                            "",
                            "- Sessions/auth state: `docker/web/settings/opencode-share` (host, shared with the CLI)",
                            "- Config: `docker/web/settings/opencode` (host, shared with the CLI)"
                        ]
                    }
                ],
                "cleanup_directories": [
                    "docker/chat"
                ]
            },
            "compose_service": {
                "service": "chat",
                "definition": {
                    "build": "./docker/chat",
                    "restart": "unless-stopped",
                    "ports": [
                        "4580:4580"
                    ],
                    "working_dir": "/app",
                    "environment": {
                        "CHAT_USERNAME": "",
                        "CHAT_PASSWORD": "",
                        "OPENCODE_API_KEY": "",
                        "OPENCODE_PROVIDER": "",
                        "OPENCODE_MODEL": "",
                        "PORT": "4580"
                    },
                    "volumes": [
                        "./:/app",
                        "./docker/web/settings/opencode:/home/application/.config/opencode",
                        "./docker/web/settings/opencode-share:/home/application/.local/share/opencode"
                    ]
                }
            },
            "dashboard_shell": {
                "label": "Chat",
                "routing": {
                    "path": "chat",
                    "container_port": 4580,
                    "environment": {
                        "CHAT_BASE_PATH": "{{path}}"
                    }
                },
                "port_field": "port",
                "username_field": "username",
                "password_field": "password",
                "button_label": "Open Chat",
                "help_title": "Configure Chat",
                "help_text": "Set username and password in the Addons section, then rebuild the stack to apply changes. The dashboard button opens the chat UI. Provider access is configured once via \"opencode auth login\" (shared with the OpenCode CLI) or with the api_key addon setting.",
                "help_command": "./docker/rebuild.sh"
            }
        }
    ]
}
