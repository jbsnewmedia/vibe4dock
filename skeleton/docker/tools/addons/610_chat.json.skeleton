                    },
                    {
                        "target": "docker/chat/www/app.js",
                        "content_lines": [
                            "/* Vibe4Dock Chat - vanilla JS frontend for a headless opencode server. */",
                            "(function () {",
                            "    'use strict';",
                            "",
                            "    if (location.username || location.password) {",
                            "        try {",
                            "            history.replaceState(null, '', location.pathname + location.search + location.hash);",
                            "        } catch (e) {}",
                            "    }",
                            "",
                            "    var state = {",
                            "        sessions: [],",
                            "        sessionId: null,",
                            "        sessionTitle: '',",
                            "        generating: false,",
                            "        lastRendered: null,",
                            "        pendingQuestions: [],",
                            "        pendingPermissions: [],",
                            "        lastPendingSig: null",
                            "    };",
                            "",
                            "    var el = {",
                            "        messages: document.getElementById('messages'),",
                            "        pending: document.getElementById('pending'),",
                            "        prompt: document.getElementById('prompt'),",
                            "        composer: document.getElementById('composer'),",
                            "        sendBtn: document.getElementById('send-btn'),",
                            "        stopBtn: document.getElementById('stop-btn'),",
                            "        sessionList: document.getElementById('session-list'),",
                            "        sessionTitle: document.getElementById('session-title'),",
                            "        newChat: document.getElementById('new-chat'),",
                            "        sidebar: document.getElementById('sidebar'),",
                            "        toggleSidebar: document.getElementById('toggle-sidebar')",
                            "    };",
                            "",
                            "    var API_BASE = location.origin + location.pathname.replace(/\\/[^/]*$/, '/') + 'api';",
                            "",
                            "    function api(method, path, body) {",
                            "        return fetch(API_BASE + path, {",
                            "            method: method,",
                            "            headers: body ? { 'Content-Type': 'application/json' } : undefined,",
                            "            body: body ? JSON.stringify(body) : undefined",
                            "        }).then(function (r) {",
                            "            if (!r.ok) { throw new Error('HTTP ' + r.status + ' on ' + path); }",
                            "            var ct = r.headers.get('content-type') || '';",
                            "            return ct.indexOf('json') !== -1 ? r.json() : r.text();",
                            "        });",
                            "    }",
                            "",
                            "    function esc(s) {",
                            "        return String(s == null ? '' : s)",
                            "            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')",
                            "            .replace(/\"/g, '&quot;');",
                            "    }",
                            "",
                            "    function md(text) {",
                            "        var parts = String(text == null ? '' : text).split(/```/);",
                            "        var out = '';",
                            "        for (var i = 0; i < parts.length; i++) {",
                            "            if (i % 2 === 1) {",
                            "                var block = parts[i].replace(/^[a-zA-Z0-9_+-]*\\n/, '');",
                            "                out += '<pre><code>' + esc(block) + '</code></pre>';",
                            "            } else {",
                            "                var seg = esc(parts[i]);",
                            "                seg = seg.replace(/`([^`\\n]+)`/g, '<code>$1</code>');",
                            "                seg = seg.replace(/\\*\\*([^*\\n]+)\\*\\*/g, '<strong>$1</strong>');",
                            "                out += seg;",
                            "            }",
                            "        }",
                            "        return out;",
                            "    }",
                            "",
                            "    function toolSummary(part) {",
                            "        var st = part.state || {};",
                            "        var input = st.input || {};",
                            "        var lines = [];",
                            "        var name = part.tool || 'tool';",
                            "        var status = st.status || 'pending';",
                            "        var head = '<span class=\"tool-name\">' + esc(name) + '</span> <em>(' + esc(status) + ')</em>';",
                            "        lines.push(head);",
                            "        if (input.command || input.cmd || input.description) {",
                            "            lines.push('<div class=\"tool-cmd\">' + esc(input.command || input.cmd || input.description) + '</div>');",
                            "        } else if (input.filePath || input.path) {",
                            "            lines.push('<div class=\"tool-cmd\">' + esc(input.filePath || input.path) + '</div>');",
                            "        }",
                            "        if (status === 'completed' || status === 'error') {",
                            "            var out = '';",
                            "            if (typeof st.output === 'string') { out = st.output; }",
                            "            else if (st.metadata && typeof st.metadata.output === 'string') { out = st.metadata.output; }",
                            "            if (out) { lines.push('<div class=\"tool-out\">' + esc(out.slice(0, 4000)) + '</div>'); }",
                            "        }",
                            "        return '<div class=\"thinking-entry\">' + lines.join('') + '</div>';",
                            "    }",
                            "",
                            "    function renderMessage(m) {",
                            "        var info = m.info || m;",
                            "        var role = info.role || 'user';",
                            "        var parts = m.parts || [];",
                            "        var wrap = document.createElement('div');",
                            "        wrap.className = 'msg ' + (role === 'user' ? 'user' : 'assistant');",
                            "",
                            "        var who = document.createElement('div');",
                            "        who.className = 'who';",
                            "        who.textContent = role === 'user' ? 'You' : 'opencode';",
                            "        wrap.appendChild(who);",
                            "",
                            "        var answer = document.createElement('div');",
                            "        answer.className = 'bubble';",
                            "",
                            "        var thinking = null;",
                            "        var thinkingBody = null;",
                            "        var thinkingCount = 0;",
                            "",
                            "        for (var i = 0; i < parts.length; i++) {",
                            "            var p = parts[i];",
                            "            if (p.type === 'text' && p.text) {",
                            "                answer.insertAdjacentHTML('beforeend', md(p.text));",
                            "            } else if (p.type === 'reasoning' && p.text) {",
                            "                ensureThinking();",
                            "                thinkingBody.insertAdjacentHTML('beforeend', '<div class=\"thinking-entry\">' + md(p.text) + '</div>');",
                            "                thinkingCount++;",
                            "            } else if (p.type === 'tool') {",
                            "                ensureThinking();",
                            "                thinkingBody.insertAdjacentHTML('beforeend', toolSummary(p));",
                            "                thinkingCount++;",
                            "            }",
                            "        }",
                            "",
                            "        function ensureThinking() {",
                            "            if (thinking) { return; }",
                            "            thinking = document.createElement('details');",
                            "            thinking.className = 'thinking';",
                            "            var summary = document.createElement('summary');",
                            "            summary.innerHTML = '<span class=\"spinner\"></span>Thinking &amp; Tools';",
                            "            thinking.appendChild(summary);",
                            "            thinkingBody = document.createElement('div');",
                            "            thinkingBody.className = 'thinking-body';",
                            "            thinking.appendChild(thinkingBody);",
                            "        }",
                            "",
                            "        if (thinking) {",
                            "            var summary = thinking.querySelector('summary');",
                            "            summary.innerHTML = (state.generating ? '<span class=\"spinner\"></span>' : '') +",
                            "                'Thinking &amp; Tools (' + thinkingCount + ')';",
                            "            if (state.generating && thinkingCount > 0) { thinking.open = true; }",
                            "            wrap.appendChild(thinking);",
                            "        }",
                            "        if (answer.childNodes.length) { wrap.appendChild(answer); }",
                            "        return wrap;",
                            "    }",
                            "",
                            "    function isComplete(m) {",
                            "        var info = m.info || m;",
                            "        var t = info.time || {};",
                            "        return !!(t.completed);",
                            "    }",
                            "",
                            "    function render(messages) {",
                            "        var list = (messages || []).filter(function (m) {",
                            "            var info = m.info || m;",
                            "            return info.role === 'user' || info.role === 'assistant';",
                            "        });",
                            "        el.messages.innerHTML = '';",
                            "        if (!list.length) {",
                            "            el.messages.innerHTML = '<div class=\"empty-state\">Ask anything &ndash; the agent works directly in the project directory.</div>';",
                            "            return;",
                            "        }",
                            "        list.forEach(function (m) { el.messages.appendChild(renderMessage(m)); });",
                            "        el.messages.scrollTop = el.messages.scrollHeight;",
                            "    }",
                            "",
                            "    function renderPending() {",
                            "        var sig = JSON.stringify([state.pendingQuestions, state.pendingPermissions]);",
                            "        if (sig === state.lastPendingSig) { return; }",
                            "        state.lastPendingSig = sig;",
                            "        el.pending.innerHTML = '';",
                            "        state.pendingQuestions.forEach(function (req) {",
                            "            var box = document.createElement('div');",
                            "            box.className = 'pending-box';",
                            "            var answers = [];",
                            "            (req.questions || []).forEach(function (q) {",
                            "                var head = document.createElement('div');",
                            "                head.className = 'q';",
                            "                head.textContent = (q.header ? q.header + ' \\u2013 ' : '') + (q.question || 'Question');",
                            "                box.appendChild(head);",
                            "                var picked = {};",
                            "                var opts = q.options || [];",
                            "                if (opts.length) {",
                            "                    var optRow = document.createElement('div');",
                            "                    optRow.className = 'opts';",
                            "                    opts.forEach(function (o) {",
                            "                        var label = typeof o === 'string' ? o : (o.label || '');",
                            "                        var b = document.createElement('button');",
                            "                        b.className = 'btn';",
                            "                        b.textContent = label;",
                            "                        if (o && o.description) { b.title = o.description; }",
                            "                        b.addEventListener('click', function () {",
                            "                            picked[label] = !picked[label];",
                            "                            b.classList.toggle('btn-primary', !!picked[label]);",
                            "                        });",
                            "                        optRow.appendChild(b);",
                            "                    });",
                            "                    box.appendChild(optRow);",
                            "                }",
                            "                var input = document.createElement('input');",
                            "                input.type = 'text';",
                            "                input.placeholder = 'Custom answer (optional)';",
                            "                box.appendChild(input);",
                            "                answers.push(function () {",
                            "                    var vals = Object.keys(picked);",
                            "                    var free = input.value.trim();",
                            "                    if (free) { vals.push(free); }",
                            "                    return vals;",
                            "                });",
                            "            });",
                            "            var send = document.createElement('button');",
                            "            send.className = 'btn btn-primary';",
                            "            send.textContent = 'Send answer';",
                            "            send.addEventListener('click', function () {",
                            "                answerQuestion(req, answers.map(function (fn) { return fn(); }));",
                            "            });",
                            "            box.appendChild(send);",
                            "            el.pending.appendChild(box);",
                            "        });",
                            "",
                            "        state.pendingPermissions.forEach(function (p) {",
                            "            var box = document.createElement('div');",
                            "            box.className = 'pending-box';",
                            "            var title = document.createElement('div');",
                            "            title.className = 'q';",
                            "            title.textContent = 'Permission: ' + (p.title || p.type || 'action');",
                            "            box.appendChild(title);",
                            "            var opts = document.createElement('div');",
                            "            opts.className = 'opts';",
                            "            [['once', 'Allow'], ['always', 'Always allow'], ['reject', 'Deny']].forEach(function (pair) {",
                            "                var b = document.createElement('button');",
                            "                b.className = 'btn ' + (pair[0] === 'reject' ? 'btn-danger' : 'btn-primary');",
                            "                b.textContent = pair[1];",
                            "                b.addEventListener('click', function () { answerPermission(p, pair[0]); });",
                            "                opts.appendChild(b);",
                            "            });",
                            "            box.appendChild(opts);",
                            "            el.pending.appendChild(box);",
                            "        });",
                            "    }",
                            "",
                            "    function answerQuestion(req, payload) {",
                            "        api('POST', '/question/' + encodeURIComponent(req.id || req.requestID) + '/reply', { answers: payload })",
                            "            .then(refresh)",
                            "            .catch(function () {});",
                            "    }",
                            "",
                            "    function answerPermission(p, reply) {",
                            "        api('POST', '/permission/' + encodeURIComponent(p.id || p.permissionID) + '/reply', { reply: reply })",
                            "            .then(refresh)",
                            "            .catch(function () {});",
                            "    }",
                            "",
                            "    function loadSessions() {",
                            "        return api('GET', '/session').then(function (sessions) {",
                            "            state.sessions = (sessions || []).filter(function (s) { return !s.parentID; });",
                            "            el.sessionList.innerHTML = '';",
                            "            state.sessions.forEach(function (s) {",
                            "                var li = document.createElement('li');",
                            "                if (s.id === state.sessionId) { li.className = 'active'; el.sessionTitle.textContent = s.title || s.id; }",
                            "                var label = document.createElement('span');",
                            "                label.className = 'session-label';",
                            "                label.textContent = s.title || s.id;",
                            "                li.appendChild(label);",
                            "                var del = document.createElement('button');",
                            "                del.className = 'session-delete';",
                            "                del.textContent = '\\u00D7';",
                            "                del.title = 'Delete chat';",
                            "                del.addEventListener('click', function (e) {",
                            "                    e.stopPropagation();",
                            "                    if (del.dataset.confirm !== '1') {",
                            "                        del.dataset.confirm = '1';",
                            "                        del.classList.add('confirm');",
                            "                        del.textContent = '\\u2713';",
                            "                        setTimeout(function () {",
                            "                            del.dataset.confirm = '';",
                            "                            del.classList.remove('confirm');",
                            "                            del.textContent = '\\u00D7';",
                            "                        }, 2500);",
                            "                        return;",
                            "                    }",
                            "                    api('DELETE', '/session/' + encodeURIComponent(s.id), {}).then(function () {",
                            "                        if (state.sessionId === s.id) {",
                            "                            state.sessionId = null;",
                            "                            state.lastRendered = null;",
                            "                            state.lastPendingSig = null;",
                            "                            el.sessionTitle.textContent = 'Chat';",
                            "                            el.messages.innerHTML = '<div class=\"empty-state\">Ask anything &ndash; the agent works directly in the project directory.</div>';",
                            "                        }",
                            "                        return loadSessions();",
                            "                    }).catch(function () {});",
                            "                });",
                            "                li.appendChild(del);",
                            "                li.addEventListener('click', function () { selectSession(s.id); });",
                            "                el.sessionList.appendChild(li);",
                            "            });",
                            "        });",
                            "    }",
                            "",
                            "    function refresh() {",
                            "        var jobs = [loadSessions()];",
                            "        if (state.sessionId) {",
                            "            jobs.push(api('GET', '/session/' + state.sessionId + '/message').then(function (msgs) {",
                            "                var wasGenerating = state.generating;",
                            "                state.generating = (msgs || []).some(function (m) {",
                            "                    var info = m.info || m;",
                            "                    return info.role === 'assistant' && !(info.time && info.time.completed);",
                            "                });",
                            "                if (wasGenerating !== state.generating || !state.lastRendered || JSON.stringify(msgs).length !== state.lastRendered) {",
                            "                    render(msgs);",
                            "                    state.lastRendered = JSON.stringify(msgs).length;",
                            "                }",
                            "                updateControls();",
                            "            }));",
                            "            jobs.push(api('GET', '/question').then(function (qs) {",
                            "                state.pendingQuestions = (qs || []).filter(function (q) {",
                            "                    return !q.sessionID || q.sessionID === state.sessionId;",
                            "                });",
                            "                renderPending();",
                            "            }).catch(function () { state.pendingQuestions = []; }));",
                            "            jobs.push(api('GET', '/permission').then(function (ps) {",
                            "                var list = Array.isArray(ps) ? ps : ((ps && ps.permissions) || []);",
                            "                state.pendingPermissions = list.filter(function (p) {",
                            "                    return !p.sessionID || p.sessionID === state.sessionId;",
                            "                });",
                            "                renderPending();",
                            "            }).catch(function () { state.pendingPermissions = []; }));",
                            "        }",
                            "        return Promise.all(jobs.map(function (p) { return p.catch(function () {}); }));",
                            "    }",
                            "",
                            "    function updateControls() {",
                            "        el.stopBtn.hidden = !state.generating;",
                            "        el.sendBtn.disabled = state.generating;",
                            "    }",
                            "",
                            "    function selectSession(id) {",
                            "        state.sessionId = id;",
                            "        state.lastRendered = null;",
                            "        state.lastPendingSig = null;",
                            "        var s = state.sessions.find(function (x) { return x.id === id; });",
                            "        el.sessionTitle.textContent = (s && (s.title || s.id)) || 'Chat';",
                            "        refresh().then(function () {",
                            "            el.sessionList.querySelectorAll('li').forEach(function (li) { li.classList.remove('active'); });",
                            "        });",
                            "    }",
                            "",
                            "    function newChat() {",
                            "        api('POST', '/session', {}).then(function (s) {",
                            "            state.sessionId = s.id;",
                            "            state.sessionTitle = s.title || 'Neuer Chat';",
                            "            el.sessionTitle.textContent = state.sessionTitle;",
                            "            state.lastRendered = null;",
                            "            render([]);",
                            "            return loadSessions();",
                            "        }).catch(function (e) {",
                            "            el.messages.innerHTML = '<div class=\"empty-state\">Could not create chat: ' + esc(e.message) + '</div>';",
                            "        });",
                            "    }",
                            "",
                            "    function send(text) {",
                            "        if (!text || state.generating) { return; }",
                            "        var body = { parts: [{ type: 'text', text: text }] };",
                            "        if (window.CHAT_CONFIG && window.CHAT_CONFIG.provider && window.CHAT_CONFIG.model) {",
                            "            body.providerID = window.CHAT_CONFIG.provider;",
                            "            body.modelID = window.CHAT_CONFIG.model;",
                            "        }",
                            "        var ensure = state.sessionId",
                            "            ? Promise.resolve()",
                            "            : api('POST', '/session', {}).then(function (s) { state.sessionId = s.id; });",
                            "        ensure.then(function () {",
                            "            el.prompt.value = '';",
                            "            el.prompt.style.height = 'auto';",
                            "            state.generating = true;",
                            "            updateControls();",
                            "            return api('POST', '/session/' + state.sessionId + '/prompt_async', body);",
                            "        }).then(function () {",
                            "            return refresh();",
                            "        }).catch(function (e) {",
                            "            state.generating = false;",
                            "            updateControls();",
                            "            el.pending.innerHTML = '<div class=\"pending-box\"><div class=\"q\">Fehler: ' + esc(e.message) +",
                            "                '</div>Hint: Is a provider configured? Run <code>opencode auth login</code> in the application shell or in this container.</div>';",
                            "        });",
                            "    }",
                            "",
                            "    el.composer.addEventListener('submit', function (e) {",
                            "        e.preventDefault();",
                            "        send(el.prompt.value.trim());",
                            "    });",
                            "",
                            "    el.prompt.addEventListener('keydown', function (e) {",
                            "        if (e.key === 'Enter' && !e.shiftKey) {",
                            "            e.preventDefault();",
                            "            send(el.prompt.value.trim());",
                            "        }",
                            "    });",
                            "",
                            "    el.prompt.addEventListener('input', function () {",
                            "        el.prompt.style.height = 'auto';",
                            "        el.prompt.style.height = Math.min(el.prompt.scrollHeight, 180) + 'px';",
                            "    });",
                            "",
                            "    el.stopBtn.addEventListener('click', function () {",
                            "        if (state.sessionId) { api('POST', '/session/' + state.sessionId + '/abort', {}).then(refresh).catch(function () {}); }",
                            "    });",
                            "",
                            "    el.newChat.addEventListener('click', newChat);",
                            "",
                            "    el.toggleSidebar.addEventListener('click', function () {",
                            "        el.sidebar.classList.toggle('hidden');",
                            "    });",
                            "",
                            "    refresh().then(function () {",
                            "        if (!state.sessionId && state.sessions.length) {",
                            "            selectSession(state.sessions[0].id);",
                            "        }",
                            "    });",
                            "    setInterval(refresh, 1500);",
                            "})();"
                        ]
                    },
                    {
                        "target": "docker/chat/www/style.css",
                        "content_lines": [
                            ":root {",
                            "    --primary: #8ef;",
                            "    --primary-dark: #008ba3;",
                            "    --primary-dim: rgba(136, 238, 255, 0.1);",
                            "    --primary-status-bg: rgba(136, 238, 255, 0.2);",
                            "    --primary-status-border: rgba(136, 238, 255, 0.3);",
                            "    --original-red: #cd1719;",
                            "    --bg-body: #0f1115;",
                            "    --bg-body-accent: #172033;",
                            "    --bg-card: #181c23;",
                            "    --bg-card-hover: #212733;",
                            "    --border: #2b3340;",
                            "    --border-light: #202733;",
                            "    --text: #e0e0e0;",
                            "    --text-dim: #aaa;",
                            "    --text-white: #fff;",
                            "    --text-dark: #555;",
                            "    --bg-black: #000;",
                            "    --bg-btn-secondary: #444;",
                            "    --bg-btn-secondary-hover: #555;",
                            "    font-size: 15px;",
                            "}",
                            "",
                            "* { box-sizing: border-box; }",
                            "",
                            "html, body {",
                            "    margin: 0;",
                            "    height: 100%;",
                            "    background: var(--bg-body);",
                            "    color: var(--text);",
                            "    font-family: 'Segoe UI', system-ui, sans-serif;",
                            "    line-height: 1.5;",
                            "}",
                            "",
                            "body::before {",
                            "    content: \"\";",
                            "    position: fixed;",
                            "    inset: 0;",
                            "    pointer-events: none;",
                            "    z-index: 0;",
                            "    background: radial-gradient(circle at top, var(--bg-body-accent) 0%, transparent 55%);",
                            "}",
                            "",
                            "#app { display: flex; height: 100vh; position: relative; z-index: 1; }",
                            "",
                            "#sidebar {",
                            "    width: 250px;",
                            "    background: rgba(24, 28, 35, 0.75);",
                            "    border-right: 1px solid var(--border);",
                            "    padding: 14px 12px;",
                            "    overflow-y: auto;",
                            "    flex-shrink: 0;",
                            "    display: flex;",
                            "    flex-direction: column;",
                            "}",
                            "",
                            "#sidebar.hidden { display: none; }",
                            "",
                            "#brand {",
                            "    display: flex;",
                            "    align-items: center;",
                            "    gap: 12px;",
                            "    padding: 2px 4px 14px;",
                            "    border-bottom: 1px solid var(--border-light);",
                            "    margin-bottom: 14px;",
                            "}",
                            "",
                            "#brand svg { width: 48px; height: 48px; flex-shrink: 0; }",
                            "#brand .brand-name { font-size: 1.8em; font-weight: bold; color: var(--text-white); letter-spacing: -0.5px; }",
                            "",
                            "#new-chat { width: 100%; }",
                            "",
                            "#session-list { list-style: none; margin: 14px 0 0; padding: 0; }",
                            "",
                            "#session-list li {",
                            "    padding: 9px 12px;",
                            "    border-radius: 8px;",
                            "    cursor: pointer;",
                            "    color: var(--text-dim);",
                            "    font-size: 0.92em;",
                            "    font-weight: 600;",
                            "    white-space: nowrap;",
                            "    overflow: hidden;",
                            "    text-overflow: ellipsis;",
                            "    transition: background 0.2s, color 0.2s;",
                            "}",
                            "",
                            "#session-list li:hover { background: var(--bg-card-hover); color: var(--text); }",
                            "#session-list li.active { background: var(--primary-dim); color: var(--primary); }",
                            "",
                            "#chat { flex: 1; display: flex; flex-direction: column; min-width: 0; }",
                            "",
                            "#topbar {",
                            "    display: flex;",
                            "    align-items: center;",
                            "    gap: 12px;",
                            "    padding: 14px 18px;",
                            "    border-bottom: 1px solid var(--border);",
                            "    background: rgba(24, 28, 35, 0.75);",
                            "}",
                            "",
                            "#session-title { flex: 1; font-weight: bold; color: var(--text-white); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }",
                            "",
                            "#messages { flex: 1; overflow-y: auto; padding: 26px 16px; scroll-behavior: smooth; }",
                            "",
                            ".empty-state { color: var(--text-dim); text-align: center; margin-top: 30vh; }",
                            "",
                            ".msg { max-width: 760px; margin: 0 auto 20px; }",
                            "",
                            ".msg .who { font-size: 0.78em; font-weight: bold; color: var(--primary); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.5px; }",
                            ".msg.user .who { color: var(--text-dim); }",
                            "",
                            ".msg.user .bubble {",
                            "    background: var(--bg-card);",
                            "    border: 1px solid var(--border);",
                            "    border-radius: 12px;",
                            "    padding: 12px 16px;",
                            "    white-space: pre-wrap;",
                            "    word-wrap: break-word;",
                            "    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);",
                            "}",
                            "",
                            ".msg.assistant .bubble { padding: 2px 4px; line-height: 1.6; word-wrap: break-word; }",
                            "",
                            ".bubble pre {",
                            "    background: var(--bg-black);",
                            "    padding: 14px 16px;",
                            "    border-radius: 12px;",
                            "    overflow-x: auto;",
                            "    color: #ccc;",
                            "    border: 1px solid var(--border);",
                            "    line-height: 1.4;",
                            "    font-size: 0.85rem;",
                            "}",
                            "",
                            ".bubble code {",
                            "    color: var(--primary);",
                            "    background: var(--primary-dim);",
                            "    padding: 2px 6px;",
                            "    border-radius: 4px;",
                            "    font-family: monospace;",
                            "}",
                            "",
                            ".bubble pre code { background: transparent; padding: 0; color: inherit; }",
                            "",
                            "details.thinking {",
                            "    background: var(--bg-card);",
                            "    border: 1px solid var(--border);",
                            "    border-radius: 12px;",
                            "    margin: 10px 0;",
                            "    font-size: 0.85rem;",
                            "    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);",
                            "}",
                            "",
                            "details.thinking > summary {",
                            "    cursor: pointer;",
                            "    padding: 9px 12px;",
                            "    color: var(--text-dim);",
                            "    user-select: none;",
                            "    list-style: none;",
                            "}",
                            "",
                            "details.thinking > summary::before { content: \"\\25B8 \"; color: var(--primary); }",
                            "details.thinking[open] > summary::before { content: \"\\25BE \"; }",
                            "",
                            "details.thinking .thinking-body { padding: 0 12px 10px; color: var(--text-dim); }",
                            "",
                            ".thinking-entry { border-top: 1px solid var(--border-light); padding: 7px 0; }",
                            ".thinking-entry:first-child { border-top: none; }",
                            "",
                            ".thinking-entry .tool-name { color: var(--primary); font-weight: bold; }",
                            ".thinking-entry em { color: var(--text-dim); font-style: normal; }",
                            "",
                            ".thinking-entry .tool-cmd {",
                            "    font-family: 'Cascadia Code', 'Fira Code', monospace;",
                            "    color: var(--text);",
                            "    background: var(--bg-black);",
                            "    border: 1px solid var(--border);",
                            "    border-radius: 6px;",
                            "    padding: 5px 9px;",
                            "    margin-top: 4px;",
                            "    white-space: pre-wrap;",
                            "    word-break: break-all;",
                            "}",
                            "",
                            ".thinking-entry .tool-out {",
                            "    font-family: 'Cascadia Code', 'Fira Code', monospace;",
                            "    white-space: pre-wrap;",
                            "    word-break: break-word;",
                            "    margin-top: 4px;",
                            "    max-height: 240px;",
                            "    overflow-y: auto;",
                            "    color: #ccc;",
                            "}",
                            "",
                            ".pending-box {",
                            "    max-width: 760px;",
                            "    margin: 0 auto 14px;",
                            "    background: var(--bg-card);",
                            "    border: 1px solid var(--primary-status-border);",
                            "    border-radius: 12px;",
                            "    padding: 14px 18px;",
                            "    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3), 0 0 0 3px var(--primary-dim);",
                            "}",
                            "",
                            ".pending-box .q { font-weight: bold; color: var(--text-white); margin-bottom: 10px; }",
                            ".pending-box .opts { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0; }",
                            ".pending-box input[type=text] {",
                            "    width: 100%;",
                            "    background: var(--bg-black);",
                            "    color: var(--text-white);",
                            "    border: 1px solid var(--border);",
                            "    border-radius: 6px;",
                            "    padding: 10px;",
                            "    margin-top: 10px;",
                            "    font: inherit;",
                            "    box-sizing: border-box;",
                            "}",
                            ".pending-box input[type=text]:focus { outline: 2px solid var(--primary); outline-offset: 1px; }",
                            ".pending-box .btn { margin-top: 10px; }",
                            "",
                            ".spinner {",
                            "    display: inline-block;",
                            "    width: 12px;",
                            "    height: 12px;",
                            "    border: 3px solid rgba(136, 238, 255, 0.2);",
                            "    border-top-color: var(--primary);",
                            "    border-radius: 50%;",
                            "    animation: spin 0.8s linear infinite;",
                            "    vertical-align: -2px;",
                            "    margin-right: 6px;",
                            "}",
                            "",
                            "@keyframes spin { to { transform: rotate(360deg); } }",
                            "",
                            "#composer {",
                            "    display: flex;",
                            "    gap: 10px;",
                            "    padding: 14px 16px 18px;",
                            "    max-width: 792px;",
                            "    margin: 0 auto;",
                            "    width: 100%;",
                            "}",
                            "",
                            "#prompt {",
                            "    flex: 1;",
                            "    resize: none;",
                            "    background: var(--bg-card);",
                            "    color: var(--text-white);",
                            "    border: 1px solid var(--border);",
                            "    border-radius: 10px;",
                            "    padding: 12px 14px;",
                            "    font: inherit;",
                            "    max-height: 180px;",
                            "    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);",
                            "}",
                            "",
                            "#prompt:focus { outline: 2px solid var(--primary); outline-offset: 1px; }",
                            "#prompt::placeholder { color: var(--text-dim); }",
                            "",
                            ".btn {",
                            "    border: none;",
                            "    background: var(--bg-btn-secondary);",
                            "    color: #eee;",
                            "    border-radius: 6px;",
                            "    padding: 10px 18px;",
                            "    cursor: pointer;",
                            "    font-weight: bold;",
                            "    font-size: 0.9em;",
                            "    transition: opacity 0.2s, background-color 0.2s;",
                            "}",
                            "",
                            ".btn:hover { opacity: 0.9; }",
                            ".btn:disabled { opacity: 0.5; cursor: not-allowed; }",
                            ".btn-primary { background: var(--primary); color: var(--text-dark); }",
                            ".btn-danger { background: var(--original-red); color: var(--text-white); }",
                            ".btn-icon { padding: 8px 11px; background: transparent; border: 1px solid var(--border); color: var(--text-dim); }",
                            ".btn-icon:hover { background: var(--bg-card-hover); color: var(--text); }",
                            "",
                            "#stop-btn { padding: 8px 14px; font-size: 0.85em; }",
                            "",
                            "#footer {",
                            "    border-top: 1px solid var(--border);",
                            "    padding: 12px 16px;",
                            "    color: var(--text-dim);",
                            "    font-size: 0.78em;",
                            "    text-align: center;",
                            "    background: rgba(24, 28, 35, 0.75);",
                            "}",
                            "",
                            "#footer .footer-inner { display: flex; align-items: center; justify-content: center; gap: 10px; }",
                            "#footer .footer-logo { width: 20px; height: 20px; flex-shrink: 0; }",
                            "#footer .footer-logo svg { width: 100%; height: 100%; display: block; }",
                            "#footer strong { color: var(--text); }",
                            "#footer a { color: inherit; text-decoration: none; }",
                            "#footer a:hover { text-decoration: underline; }",
                            "",
                            "#session-list li { position: relative; padding-right: 28px; }",
                            "",
                            "#session-list .session-label {",
                            "    display: block;",
                            "    overflow: hidden;",
                            "    text-overflow: ellipsis;",
                            "    white-space: nowrap;",
                            "}",
                            "",
                            "#session-list .session-delete {",
                            "    position: absolute;",
                            "    right: 6px;",
                            "    top: 50%;",
                            "    transform: translateY(-50%);",
                            "    background: transparent;",
                            "    border: none;",
                            "    color: var(--text-dim);",
                            "    font-size: 1em;",
                            "    line-height: 1;",
                            "    padding: 3px 6px;",
                            "    border-radius: 5px;",
                            "    cursor: pointer;",
                            "    opacity: 0;",
                            "    transition: opacity 0.15s, color 0.15s, background 0.15s;",
                            "    font-family: inherit;",
                            "}",
                            "",
                            "#session-list li:hover .session-delete { opacity: 1; }",
                            "#session-list .session-delete:hover { color: var(--text-white); background: var(--bg-btn-secondary); }",
                            "#session-list .session-delete.confirm { color: var(--text-white); background: var(--original-red); opacity: 1; }",
                            "",
                            "* { scrollbar-width: thin; scrollbar-color: var(--border) transparent; }",
                            "",
                            "::-webkit-scrollbar { width: 8px; height: 8px; }",
                            "::-webkit-scrollbar-track { background: transparent; }",
                            "::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }",
                            "::-webkit-scrollbar-thumb:hover { background: #3d4757; }",
                            "::-webkit-scrollbar-corner { background: transparent; }",
                            "",
                            "@media (max-width: 700px) {",
                            "    #sidebar { position: absolute; z-index: 10; height: 100%; background: var(--bg-card); }",
                            "    #sidebar.hidden { display: none; }",
                            "}"
                        ]
                    },
                    {
                        "target": "docker/chat/README.md",
                        "content_lines": [
                            "# chat",
                            "",
                            "This directory is managed by Vibe4Dock and contains configuration for the chat addon.",
                            "",
                            "The chat addon exposes a ChatGPT-like web UI in front of a headless `opencode serve`",
                            "instance that works directly on the mounted project directory (`/app`).",
                            "",
                            "## Access",
                            "",
                            "- HTTP Basic Auth is configured with the `CHAT_USERNAME` / `CHAT_PASSWORD` addon settings.",
                            "- Without credentials the nginx front answers 403 for every request (fail closed).",
                            "",
                            "## Provider",
                            "",
                            "opencode reads its provider/auth configuration from the shared state directory that is",
                            "also used by the OpenCode CLI in the application shell:",
                            "",
                            "    docker compose exec -u application chat opencode auth login",
                            "",
                            "The same login also enables the CLI inside the web container (shared",
                            "`/home/application/.config/opencode` and `/home/application/.local/share/opencode`).",
                            "",
                            "Optional: set provider, model, and API key in the addon settings",
                            "(`OPENCODE_PROVIDER`, `OPENCODE_MODEL`, `OPENCODE_API_KEY`) to pin the model per request.",
                            "",
                            "## Data",
                            "",
                            "- Sessions/auth state: `docker/web/settings/opencode-share` (host, shared with the CLI)",
                            "- Config: `docker/web/settings/opencode` (host, shared with the CLI)"
                        ]
                    }
                ],
                "cleanup_directories": [
                    "docker/chat"
                ]
            },
            "compose_service": {
                "service": "chat",
                "definition": {
                    "build": "./docker/chat",
                    "restart": "unless-stopped",
                    "ports": [
                        "4580:4580"
                    ],
                    "working_dir": "/app",
                    "environment": {
                        "CHAT_USERNAME": "",
                        "CHAT_PASSWORD": "",
                        "OPENCODE_API_KEY": "",
                        "OPENCODE_PROVIDER": "",
                        "OPENCODE_MODEL": "",
                        "PORT": "4580"
                    },
                    "volumes": [
                        "./:/app",
                        "./docker/web/settings/opencode:/home/application/.config/opencode",
                        "./docker/web/settings/opencode-share:/home/application/.local/share/opencode"
                    ]
                }
            },
            "dashboard_shell": {
                "label": "Chat",
                "routing": {
                    "path": "chat",
                    "container_port": 4580,
                    "environment": {
                        "CHAT_BASE_PATH": "{{path}}"
                    }
                },
                "port_field": "port",
                "username_field": "username",
                "password_field": "password",
                "button_label": "Open Chat",
                "help_title": "Configure Chat",
                "help_text": "Set username and password in the Addons section, then rebuild the stack to apply changes. The dashboard button opens the chat UI. Provider access is configured once via \"opencode auth login\" (shared with the OpenCode CLI) or with the api_key addon setting.",
                "help_command": "./docker/rebuild.sh"
            }
        }
    ]
}
