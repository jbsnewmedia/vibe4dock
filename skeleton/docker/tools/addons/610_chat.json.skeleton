{
    "categories": [
        {
            "unique_key": "ai-assistants",
            "id": "ai-assistants",
            "label": "AI Assistants",
            "order": 600,
            "menu_group": "addons"
        }
    ],
    "tools": [
        {
            "id": "chat",
            "category": "ai-assistants",
            "label": "Chat",
            "description": "ChatGPT-like web UI in front of a headless opencode agent working on the project. Shell activity is shown in a collapsible thinking panel; agent questions and permission requests appear as interactive bubbles.",
            "usage": "",
            "check": "false",
            "install": "true",
            "uninstall": "true",
            "dependencies": [
                "opencode-cli"
            ],
            "config_schema": {
                "fields": [
                    {
                        "key": "port",
                        "label": "Web UI port",
                        "default": "4580",
                        "help_text": "Host port for the chat web interface.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "ports.0",
                                "format": "%s:4580",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "username",
                        "required": false,
                        "label": "Username",
                        "default": "",
                        "help_text": "HTTP Basic Auth username for the chat UI. Without username and password the chat UI is accessible without authentication (like the shells).",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.CHAT_USERNAME",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "password",
                        "required": false,
                        "label": "Password",
                        "type": "password",
                        "default": "",
                        "help_text": "HTTP Basic Auth password for the chat UI. Protection is only enabled when username and password are both set.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.CHAT_PASSWORD",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "api_key",
                        "required": false,
                        "label": "Provider API key",
                        "type": "password",
                        "default": "",
                        "help_text": "Optional API key passed to opencode as OPENCODE_API_KEY. Leave empty to run \"opencode auth login\" instead (shared with the OpenCode CLI in the application shell).",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.OPENCODE_API_KEY",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "provider",
                        "required": false,
                        "label": "Provider",
                        "default": "",
                        "help_text": "Optional provider id sent with every prompt (e.g. anthropic, openai, google, opencode). Empty = opencode default.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.OPENCODE_PROVIDER",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "model",
                        "required": false,
                        "label": "Model",
                        "default": "",
                        "help_text": "Optional model id sent with every prompt (e.g. claude-sonnet-4-5). Empty = opencode default.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.OPENCODE_MODEL",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    },
                    {
                        "key": "agent",
                        "required": false,
                        "label": "Agent",
                        "default": "",
                        "help_text": "Optional opencode agent / persona id preselected in the chat UI (e.g. build, plan or a custom primary agent from ~/.config/opencode/agent/). Empty = no preselection.",
                        "sources": [
                            {
                                "type": "docker_yaml",
                                "path": "environment.OPENCODE_AGENT",
                                "target_services": [
                                    "chat"
                                ]
                            }
                        ]
                    }
                ]
            },
            "package_operations": {
                "templates": [
                    {
                        "target": "docker/chat/Dockerfile",
                        "content_lines": [
                            "FROM debian:bookworm-slim",
                            "",
                            "ENV DEBIAN_FRONTEND=noninteractive",
                            "ENV TERM=xterm-256color",
                            "",
                            "RUN apt-get update \\",
                            "    && apt-get install -y --no-install-recommends \\",
                            "        ca-certificates \\",
                            "        curl \\",
                            "        git \\",
                            "        nginx \\",
                            "        openssl \\",
                            "        sudo \\",
                            "    && rm -rf /var/lib/apt/lists/* \\",
                            "    && useradd -m -s /bin/bash application",
                            "",
                            "RUN sudo -u application env HOME=/home/application bash -lc 'curl -fsSL https://opencode.ai/install | bash -s --'",
                            "",
                            "COPY start.sh /usr/local/bin/start.sh",
                            "COPY www /var/www/chat",
                            "RUN chmod +x /usr/local/bin/start.sh \\",
                            "    && rm -f /etc/nginx/sites-enabled/default",
                            "",
                            "EXPOSE 4580",
                            "",
                            "CMD [\"/usr/local/bin/start.sh\"]"
                        ]
                    },
                    {
                        "target": "docker/chat/start.sh",
                        "mode": "0755",
                        "content_lines": [
                            "#!/bin/sh",
                            "set -e",
                            "",
                            "PORT_VALUE=\"${PORT:-4580}\"",
                            "API_PORT=4577",
                            "export PATH=\"/home/application/.opencode/bin:$PATH\"",
                            "",
                            "if [ -n \"${OPENCODE_API_KEY:-}\" ]; then",
                            "    export ANTHROPIC_API_KEY=\"${OPENCODE_API_KEY}\"",
                            "    export OPENAI_API_KEY=\"${OPENCODE_API_KEY}\"",
                            "fi",
                            "",
                            "mkdir -p /home/application/.config/opencode /home/application/.local/share/opencode /home/application/.local/state/opencode",
                            "chown -R application:application /home/application /var/www/chat",
                            "",
                            "cat > /var/www/chat/config.js <<CFG",
                            "window.CHAT_CONFIG = {",
                            "    provider: \"${OPENCODE_PROVIDER:-}\",",
                            "    model: \"${OPENCODE_MODEL:-}\",",
                            "    agent: \"${OPENCODE_AGENT:-}\"",
                            "};",
                            "CFG",
                            "",
                            "ASSET_V=\"$(date +%s)\"",
                            "sed -i \"s/app.js/app.js?v=${ASSET_V}/; s/i18n.js/i18n.js?v=${ASSET_V}/; s/md.js/md.js?v=${ASSET_V}/; s/style.css/style.css?v=${ASSET_V}/; s/config.js/config.js?v=${ASSET_V}/\" /var/www/chat/index.html",
                            "",
                            "if [ -n \"${CHAT_USERNAME:-}\" ] && [ -n \"${CHAT_PASSWORD:-}\" ]; then",
                            "    HASH=\"$(openssl passwd -apr1 \"$CHAT_PASSWORD\")\"",
                            "    printf '%s:%s\\n' \"$CHAT_USERNAME\" \"$HASH\" > /etc/nginx/chat.htpasswd",
                            "    printf '    auth_basic \"Vibe4Dock Chat 2026-09\";\\n    auth_basic_user_file /etc/nginx/chat.htpasswd;\\n' > /etc/nginx/chat-auth.inc",
                            "else",
                            "    echo \"CHAT_USERNAME/CHAT_PASSWORD not set - chat UI is accessible without authentication.\" >&2",
                            "    : > /etc/nginx/chat-auth.inc",
                            "fi",
                            "",
                            "BP=\"${CHAT_BASE_PATH:-}\"",
                            "if [ -n \"$BP\" ]; then",
                            "    cat > /etc/nginx/conf.d/chat.conf <<NGINX",
                            "server {",
                            "    listen ${PORT_VALUE};",
                            "    server_name _;",
                            "    absolute_redirect off;",
                            "    client_max_body_size 50m;",
                            "",
                            "    include /etc/nginx/chat-auth.inc;",
                            "",
                            "    location = ${BP} {",
                            "        return 301 ${BP}/;",
                            "    }",
                            "",
                            "    location = ${BP}/api/upload {",
                            "        proxy_pass http://tools:8090/api/upload;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "        proxy_set_header X-Real-IP \\$remote_addr;",
                            "        client_max_body_size 200m;",
                            "        proxy_read_timeout 300s;",
                            "        proxy_send_timeout 300s;",
                            "    }",
                            "",
                            "    location = ${BP}/api/upload/list {",
                            "        proxy_pass http://tools:8090/api/upload/list;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "    }",
                            "",
                            "    location = ${BP}/models.json {",
                            "        alias /home/application/.local/state/opencode/model.json;",
                            "        default_type application/json;",
                            "        add_header Cache-Control \"no-cache\";",
                            "    }",
                            "",
                            "    location ${BP}/api/ {",
                            "        proxy_pass http://127.0.0.1:${API_PORT}/;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "        proxy_set_header X-Real-IP \\$remote_addr;",
                            "        proxy_buffering off;",
                            "        proxy_read_timeout 3600s;",
                            "        proxy_send_timeout 3600s;",
                            "    }",
                            "",
                            "    location ${BP}/ {",
                            "        alias /var/www/chat/;",
                            "        index index.html;",
                            "        add_header Cache-Control \"no-cache\";",
                            "        try_files \\$uri \\$uri/ ${BP}/index.html;",
                            "    }",
                            "",
                            "    location / {",
                            "        return 404;",
                            "    }",
                            "}",
                            "NGINX",
                            "else",
                            "    cat > /etc/nginx/conf.d/chat.conf <<NGINX",
                            "server {",
                            "    listen ${PORT_VALUE};",
                            "    server_name _;",
                            "    absolute_redirect off;",
                            "    root /var/www/chat;",
                            "    index index.html;",
                            "    client_max_body_size 50m;",
                            "",
                            "    include /etc/nginx/chat-auth.inc;",
                            "",
                            "    location = / {",
                            "        add_header Cache-Control \"no-cache\";",
                            "        try_files /index.html =404;",
                            "    }",
                            "",
                            "    location = /api/upload {",
                            "        proxy_pass http://tools:8090/api/upload;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "        proxy_set_header X-Real-IP \\$remote_addr;",
                            "        client_max_body_size 200m;",
                            "        proxy_read_timeout 300s;",
                            "        proxy_send_timeout 300s;",
                            "    }",
                            "",
                            "    location = /api/upload/list {",
                            "        proxy_pass http://tools:8090/api/upload/list;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "    }",
                            "",
                            "    location = /models.json {",
                            "        alias /home/application/.local/state/opencode/model.json;",
                            "        default_type application/json;",
                            "        add_header Cache-Control \"no-cache\";",
                            "    }",
                            "",
                            "    location /api/ {",
                            "        proxy_pass http://127.0.0.1:${API_PORT}/;",
                            "        proxy_http_version 1.1;",
                            "        proxy_set_header Host \\$host;",
                            "        proxy_set_header X-Real-IP \\$remote_addr;",
                            "        proxy_buffering off;",
                            "        proxy_read_timeout 3600s;",
                            "        proxy_send_timeout 3600s;",
                            "    }",
                            "",
                            "    location / {",
                            "        add_header Cache-Control \"no-cache\";",
                            "        try_files \\$uri /index.html;",
                            "    }",
                            "}",
                            "NGINX",
                            "fi",
                            "",
                            "sudo -E -u application env HOME=/home/application \\",
                            "    PATH=\"/home/application/.opencode/bin:$PATH\" \\",
                            "    opencode serve --hostname 127.0.0.1 --port \"${API_PORT}\" --print-logs --log-level INFO &",
                            "",
                            "exec nginx -g 'daemon off;'"
                        ]
                    },
                    {
                        "target": "docker/chat/www/index.html",
                        "source": "www/index.html"
                    },
                    {
                        "target": "docker/chat/www/app.js",
                        "source": "www/app.js"
                    },
                    {
                        "target": "docker/chat/www/style.css",
                        "source": "www/style.css"
                    },
                    {
                        "target": "docker/chat/README.md",
                        "content_lines": [
                            "# chat",
                            "",
                            "This directory is managed by Vibe4Dock and contains configuration for the chat addon.",
                            "",
                            "The chat addon exposes a ChatGPT-like web UI in front of a headless `opencode serve`",
                            "instance that works directly on the mounted project directory (`/app`).",
                            "",
                            "## Dependency",
                            "",
                            "- The chat addon requires the bundled `opencode-cli` tool (AI CLI category).",
                            "- Install the OpenCode CLI first; the chat cannot be installed without it and no other agent backend is supported.",
                            "",
                            "## Access",
                            "",
                            "- HTTP Basic Auth is optional and is configured with the `CHAT_USERNAME` / `CHAT_PASSWORD` addon settings.",
                            "- Without credentials the chat UI is accessible without authentication (like the shells). As soon as both settings are filled, HTTP Basic Auth is enabled.",
                            "",
                            "## Provider",
                            "",
                            "opencode reads its provider/auth configuration from the shared state directory that is",
                            "also used by the OpenCode CLI in the application shell:",
                            "",
                            "    docker compose exec -u application chat opencode auth login",
                            "",
                            "The same login also enables the CLI inside the web container (shared",
                            "`/home/application/.config/opencode` and `/home/application/.local/share/opencode`).",
                            "",
                            "Optional: set provider, model, and API key in the addon settings",
                            "(`OPENCODE_PROVIDER`, `OPENCODE_MODEL`, `OPENCODE_API_KEY`) to pin the model per request.",
                            "",
                            "## Agents",
                            "",
                            "- The composer has an agent selector listing `build`, `plan` and every custom primary",
                            "  agent (persona) from `~/.config/opencode/agent/` or the `agent` section in `opencode.json`.",
                            "- The selected agent is sent with every prompt and remembered per browser (localStorage).",
                            "- Optional: set the `OPENCODE_AGENT` addon setting (Config dialog) to preselect a default agent.",
                            "",
                            "## Models",
                            "",
                            "- A model selector next to the agent selector lists every model of the configured",
                            "  providers (same list as `opencode models` / the TUI `/models` dialog). Each label",
                            "  shows the provider/contract in parentheses; the provider default is marked with",
                            "  `(default)`.",
                            "- The selected model (`provider/model`) is sent with every prompt and slash command",
                            "  and remembered per browser (localStorage).",
                            "",
                            "## Data",
                            "",
                            "- Sessions/auth state: `docker/web/settings/opencode-share` (host, shared with the CLI)",
                            "- Config: `docker/web/settings/opencode` (host, shared with the CLI)"
                        ]
                    },
                    {
                        "target": "docker/chat/www/i18n.js",
                        "source": "www/i18n.js"
                    },
                    {
                        "target": "docker/chat/www/md.js",
                        "source": "www/md.js"
                    },
                    {
                        "target": "docker/chat/www/sw.js",
                        "source": "www/sw.js"
                    },
                    {
                        "target": "docker/chat/www/manifest.json",
                        "source": "www/manifest.json"
                    },
                    {
                        "target": "docker/chat/www/icons/logo.svg",
                        "source": "www/icons/logo.svg"
                    },
                    {
                        "target": "docker/chat/www/icons/icon-192.png",
                        "source": "www/icons/icon-192.png"
                    },
                    {
                        "target": "docker/chat/www/icons/icon-512.png",
                        "source": "www/icons/icon-512.png"
                    },
                    {
                        "target": "docker/chat/www/icons/maskable-512.png",
                        "source": "www/icons/maskable-512.png"
                    }
                ],
                "cleanup_directories": [
                    "docker/chat"
                ]
            },
            "compose_service": {
                "service": "chat",
                "definition": {
                    "build": "./docker/chat",
                    "restart": "unless-stopped",
                    "ports": [
                        "4580:4580"
                    ],
                    "working_dir": "/app",
                    "environment": {
                        "CHAT_USERNAME": "",
                        "CHAT_PASSWORD": "",
                        "OPENCODE_API_KEY": "",
                        "OPENCODE_PROVIDER": "",
                        "OPENCODE_MODEL": "",
                        "OPENCODE_AGENT": "",
                        "PORT": "4580"
                    },
                    "volumes": [
                        "./:/app",
                        "./docker/web/settings/opencode:/home/application/.config/opencode",
                        "./docker/web/settings/opencode-share:/home/application/.local/share/opencode"
                    ]
                }
            },
            "dashboard_shell": {
                "label": "Chat",
                "routing": {
                    "path": "chat",
                    "service": "chat",
                    "container_port": 4580,
                    "environment": {
                        "CHAT_BASE_PATH": "{{path}}"
                    },
                    "auth": "cookie"
                },
                "port_field": "port",
                "username_field": "username",
                "password_field": "password",
                "button_label": "Open Chat",
                "help_title": "Configure Chat",
                "help_text": "Set username and password in the Addons section, then rebuild the stack to apply changes. The dashboard button opens the chat UI. Provider access is configured once via \"opencode auth login\" (shared with the OpenCode CLI) or with the api_key addon setting.",
                "help_command": "./docker/rebuild.sh"
            }
        }
    ]
}