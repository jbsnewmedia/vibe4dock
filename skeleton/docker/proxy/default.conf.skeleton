# Vibe4Dock reverse proxy configuration (paths routing mode).
# Mounted into the nginx:alpine proxy service. Location blocks for addons are
# regenerated by the Tools UI between the MANAGED markers below.

map $http_upgrade $vibe4dock_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name _;

    # Docker embedded DNS: managed addon locations resolve their upstream at
    # request time so the config also loads while routed addon containers are
    # not running (yet) - those requests get a clean 502 instead of breaking
    # the whole configuration.
    resolver 127.0.0.11 valid=10s ipv6=off;
    # Redirects (z.B. Form-Logins) bleiben relativ, damit sie auch hinter
    # Port-Mappings / Reverse-Proxies auf dem richtigen Host/Port landen.
    absolute_redirect off;

    client_max_body_size 200M;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $vibe4dock_connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # Tools UI (dashboard) - full path is forwarded, the UI strips its base path
    location = /vibe-dashboard {
        proxy_set_header X-Forwarded-Prefix /vibe-dashboard;
        set $vibe4dock_upstream_tools "tools";
        proxy_pass http://$vibe4dock_upstream_tools:8090;
    }
    location /vibe-dashboard/ {
        proxy_set_header X-Forwarded-Prefix /vibe-dashboard;
        set $vibe4dock_upstream_tools "tools";
        proxy_pass http://$vibe4dock_upstream_tools:8090;
    }

    # Root shell (ttyd, requires --base-path)
    location = /vibe-shell-root {
        auth_request /_vibe_shell_root_auth;
        error_page 401 = @vibe_shell_root_login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $vibe4dock_connection_upgrade;
        proxy_set_header Accept-Encoding "";
        sub_filter_types text/html;
        sub_filter_once on;
        sub_filter '</head>' '<style>*{scrollbar-width:thin;scrollbar-color:#2b3340 transparent}::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#2b3340;border-radius:5px}::-webkit-scrollbar-thumb:hover{background:#3d4757}</style><script>var t="Root Shell - Vibe4Dock";(function(){var d=Object.getOwnPropertyDescriptor(Document.prototype,"title");if(d&&d.set)d.set.call(document,t)})();Object.defineProperty(document,"title",{get:function(){return t},set:function(){}})</script></head>';
        set $vibe4dock_upstream_web "web";
        proxy_pass http://$vibe4dock_upstream_web:7681;
    }
    location /vibe-shell-root/ {
        auth_request /_vibe_shell_root_auth;
        error_page 401 = @vibe_shell_root_login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $vibe4dock_connection_upgrade;
        proxy_set_header Accept-Encoding "";
        sub_filter_types text/html;
        sub_filter_once on;
        sub_filter '</head>' '<style>*{scrollbar-width:thin;scrollbar-color:#2b3340 transparent}::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#2b3340;border-radius:5px}::-webkit-scrollbar-thumb:hover{background:#3d4757}</style><script>var t="Root Shell - Vibe4Dock";(function(){var d=Object.getOwnPropertyDescriptor(Document.prototype,"title");if(d&&d.set)d.set.call(document,t)})();Object.defineProperty(document,"title",{get:function(){return t},set:function(){}})</script></head>';
        set $vibe4dock_upstream_web "web";
        proxy_pass http://$vibe4dock_upstream_web:7681;
    }

    # Application shell (ttyd, requires --base-path)
    location = /vibe-shell-app {
        auth_request /_vibe_shell_app_auth;
        error_page 401 = @vibe_shell_app_login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $vibe4dock_connection_upgrade;
        proxy_set_header Accept-Encoding "";
        sub_filter_types text/html;
        sub_filter_once on;
        sub_filter '</head>' '<style>*{scrollbar-width:thin;scrollbar-color:#2b3340 transparent}::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#2b3340;border-radius:5px}::-webkit-scrollbar-thumb:hover{background:#3d4757}</style><script>var t="Application Shell - Vibe4Dock";(function(){var d=Object.getOwnPropertyDescriptor(Document.prototype,"title");if(d&&d.set)d.set.call(document,t)})();Object.defineProperty(document,"title",{get:function(){return t},set:function(){}})</script></head>';
        set $vibe4dock_upstream_web "web";
        proxy_pass http://$vibe4dock_upstream_web:7682;
    }
    location /vibe-shell-app/ {
        auth_request /_vibe_shell_app_auth;
        error_page 401 = @vibe_shell_app_login;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $vibe4dock_connection_upgrade;
        proxy_set_header Accept-Encoding "";
        sub_filter_types text/html;
        sub_filter_once on;
        sub_filter '</head>' '<style>*{scrollbar-width:thin;scrollbar-color:#2b3340 transparent}::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#2b3340;border-radius:5px}::-webkit-scrollbar-thumb:hover{background:#3d4757}</style><script>var t="Application Shell - Vibe4Dock";(function(){var d=Object.getOwnPropertyDescriptor(Document.prototype,"title");if(d&&d.set)d.set.call(document,t)})();Object.defineProperty(document,"title",{get:function(){return t},set:function(){}})</script></head>';
        set $vibe4dock_upstream_web "web";
        proxy_pass http://$vibe4dock_upstream_web:7682;
    }

    # Web project (catch-all)
    location / {
        set $vibe4dock_upstream_web "web";
        proxy_pass http://$vibe4dock_upstream_web:80;
    }

    # Addon form-login infrastructure (cookie auth, login served by web).
    # The per-addon auth endpoint (/_vibe_<slug>_auth) and login redirect
    # (@vibe_<slug>_login) are generated by the Tools UI inside the managed
    # block below. Only the shared /vibe-auth/ login route lives here.
    location /vibe-auth/ {
        set $vibe4dock_upstream_webauth "web";
        proxy_pass http://$vibe4dock_upstream_webauth:80;
    }
    location = /_vibe_shell_root_auth {
        internal;
        set $vibe4dock_upstream_webauth "web";
        proxy_pass http://$vibe4dock_upstream_webauth:80/vibe-auth/index.php?action=check&service=root-shell;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }
    location @vibe_shell_root_login {
        return 302 /vibe-auth/?service=root-shell&back=/vibe-shell-root%2F;
    }
    location = /_vibe_shell_app_auth {
        internal;
        set $vibe4dock_upstream_webauth "web";
        proxy_pass http://$vibe4dock_upstream_webauth:80/vibe-auth/index.php?action=check&service=app-shell;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }
    location @vibe_shell_app_login {
        return 302 /vibe-auth/?service=app-shell&back=/vibe-shell-app%2F;
    }

    # VIBE4DOCK_MANAGED_LOCATIONS_START
    # Chat (/vibe-chat)
    location = /vibe-chat {
        auth_request /_vibe_chat_auth;
        error_page 401 = @vibe_chat_login;
        set $vibe4dock_upstream "chat";
        proxy_pass http://$vibe4dock_upstream:4580;
    }
    location /vibe-chat/ {
        auth_request /_vibe_chat_auth;
        error_page 401 = @vibe_chat_login;
        set $vibe4dock_upstream "chat";
        proxy_pass http://$vibe4dock_upstream:4580;
    }
    location = /_vibe_chat_auth {
        internal;
        set $vibe4dock_upstream_webauth "web";
        proxy_pass http://$vibe4dock_upstream_webauth:80/vibe-auth/index.php?action=check&service=chat;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }
    location @vibe_chat_login {
        return 302 /vibe-auth/?service=chat&back=%2Fvibe-chat%2F;
    }
    # Veronica (/vibe-veronica)
    location = /vibe-veronica {
        auth_request /_vibe_veronica_auth;
        error_page 401 = @vibe_veronica_login;
        set $vibe4dock_upstream "veronica";
        proxy_pass http://$vibe4dock_upstream:4581;
    }
    location /vibe-veronica/ {
        auth_request /_vibe_veronica_auth;
        error_page 401 = @vibe_veronica_login;
        set $vibe4dock_upstream "veronica";
        proxy_pass http://$vibe4dock_upstream:4581;
    }
    location = /_vibe_veronica_auth {
        internal;
        set $vibe4dock_upstream_webauth "web";
        proxy_pass http://$vibe4dock_upstream_webauth:80/vibe-auth/index.php?action=check&service=veronica;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }
    location @vibe_veronica_login {
        return 302 /vibe-auth/?service=veronica&back=%2Fvibe-veronica%2F;
    }
# VIBE4DOCK_MANAGED_LOCATIONS_END
}
