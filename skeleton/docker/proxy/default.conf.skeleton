{{!PATHS_ONLY}}# Vibe4Dock reverse proxy configuration (paths routing mode).
{{!PATHS_ONLY}}# Mounted into the nginx:alpine proxy service. Location blocks for addons are
{{!PATHS_ONLY}}# regenerated by the Tools UI between the MANAGED markers below.
{{!PATHS_ONLY}}
{{!PATHS_ONLY}}map $http_upgrade $vibe4dock_connection_upgrade {
{{!PATHS_ONLY}}    default upgrade;
{{!PATHS_ONLY}}    ''      close;
{{!PATHS_ONLY}}}
{{!PATHS_ONLY}}
{{!PATHS_ONLY}}server {
{{!PATHS_ONLY}}    listen 80 default_server;
{{!PATHS_ONLY}}    server_name _;
{{!PATHS_ONLY}}
{{!PATHS_ONLY}}    # Docker embedded DNS: managed addon locations resolve their upstream at
{{!PATHS_ONLY}}    # request time so the config also loads while routed addon containers are
{{!PATHS_ONLY}}    # not running (yet) - those requests get a clean 502 instead of breaking
{{!PATHS_ONLY}}    # the whole configuration.
{{!PATHS_ONLY}}    resolver 127.0.0.11 valid=10s ipv6=off;
{{!PATHS_ONLY}}
{{!PATHS_ONLY}}    client_max_body_size 200M;
{{!PATHS_ONLY}}
{{!PATHS_ONLY}}    proxy_http_version 1.1;
{{!PATHS_ONLY}}    proxy_set_header Host $host;
{{!PATHS_ONLY}}    proxy_set_header X-Real-IP $remote_addr;
{{!PATHS_ONLY}}    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
{{!PATHS_ONLY}}    proxy_set_header X-Forwarded-Proto $scheme;
{{!PATHS_ONLY}}    proxy_set_header Upgrade $http_upgrade;
{{!PATHS_ONLY}}    proxy_set_header Connection $vibe4dock_connection_upgrade;
{{!PATHS_ONLY}}    proxy_read_timeout 3600s;
{{!PATHS_ONLY}}    proxy_send_timeout 3600s;
{{!PATHS_ONLY}}
{{!PATHS_ONLY}}    # Tools UI (dashboard) - full path is forwarded, the UI strips its base path
{{!PATHS_ONLY}}    location = {{VIBE4DOCK_BASE_PATH_DASHBOARD}} {
{{!PATHS_ONLY}}        proxy_set_header X-Forwarded-Prefix {{VIBE4DOCK_BASE_PATH_DASHBOARD}};
{{!PATHS_ONLY}}        set $vibe4dock_upstream_tools "tools";
{{!PATHS_ONLY}}        proxy_pass http://$vibe4dock_upstream_tools:{{VIBE4DOCK_TOOLS_CONTAINER_PORT}};
{{!PATHS_ONLY}}    }
{{!PATHS_ONLY}}    location {{VIBE4DOCK_BASE_PATH_DASHBOARD}}/ {
{{!PATHS_ONLY}}        proxy_set_header X-Forwarded-Prefix {{VIBE4DOCK_BASE_PATH_DASHBOARD}};
{{!PATHS_ONLY}}        set $vibe4dock_upstream_tools "tools";
{{!PATHS_ONLY}}        proxy_pass http://$vibe4dock_upstream_tools:{{VIBE4DOCK_TOOLS_CONTAINER_PORT}};
{{!PATHS_ONLY}}    }
{{!PATHS_ONLY}}
{{!PATHS_ONLY}}    # Root shell (ttyd, requires --base-path)
{{!PATHS_ONLY}}    location = {{VIBE4DOCK_BASE_PATH_ROOT_SHELL}} {
{{!PATHS_ONLY}}        proxy_set_header Host $host;
{{!PATHS_ONLY}}        proxy_set_header X-Real-IP $remote_addr;
{{!PATHS_ONLY}}        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
{{!PATHS_ONLY}}        proxy_set_header X-Forwarded-Proto $scheme;
{{!PATHS_ONLY}}        proxy_set_header Upgrade $http_upgrade;
{{!PATHS_ONLY}}        proxy_set_header Connection $vibe4dock_connection_upgrade;
{{!PATHS_ONLY}}        proxy_set_header Accept-Encoding "";
{{!PATHS_ONLY}}        sub_filter_types text/html;
{{!PATHS_ONLY}}        sub_filter_once on;
{{!PATHS_ONLY}}        sub_filter '</head>' '<style>*{scrollbar-width:thin;scrollbar-color:#2b3340 transparent}::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#2b3340;border-radius:5px}::-webkit-scrollbar-thumb:hover{background:#3d4757}</style><script>var t="Root Shell - Vibe4Dock";(function(){var d=Object.getOwnPropertyDescriptor(Document.prototype,"title");if(d&&d.set)d.set.call(document,t)})();Object.defineProperty(document,"title",{get:function(){return t},set:function(){}})</script></head>';
{{!PATHS_ONLY}}        set $vibe4dock_upstream_web "web";
{{!PATHS_ONLY}}        proxy_pass http://$vibe4dock_upstream_web:{{VIBE4DOCK_ROOT_SHELL_CONTAINER_PORT}};
{{!PATHS_ONLY}}    }
{{!PATHS_ONLY}}    location {{VIBE4DOCK_BASE_PATH_ROOT_SHELL}}/ {
{{!PATHS_ONLY}}        proxy_set_header Host $host;
{{!PATHS_ONLY}}        proxy_set_header X-Real-IP $remote_addr;
{{!PATHS_ONLY}}        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
{{!PATHS_ONLY}}        proxy_set_header X-Forwarded-Proto $scheme;
{{!PATHS_ONLY}}        proxy_set_header Upgrade $http_upgrade;
{{!PATHS_ONLY}}        proxy_set_header Connection $vibe4dock_connection_upgrade;
{{!PATHS_ONLY}}        proxy_set_header Accept-Encoding "";
{{!PATHS_ONLY}}        sub_filter_types text/html;
{{!PATHS_ONLY}}        sub_filter_once on;
{{!PATHS_ONLY}}        sub_filter '</head>' '<style>*{scrollbar-width:thin;scrollbar-color:#2b3340 transparent}::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#2b3340;border-radius:5px}::-webkit-scrollbar-thumb:hover{background:#3d4757}</style><script>var t="Root Shell - Vibe4Dock";(function(){var d=Object.getOwnPropertyDescriptor(Document.prototype,"title");if(d&&d.set)d.set.call(document,t)})();Object.defineProperty(document,"title",{get:function(){return t},set:function(){}})</script></head>';
{{!PATHS_ONLY}}        set $vibe4dock_upstream_web "web";
{{!PATHS_ONLY}}        proxy_pass http://$vibe4dock_upstream_web:{{VIBE4DOCK_ROOT_SHELL_CONTAINER_PORT}};
{{!PATHS_ONLY}}    }
{{!PATHS_ONLY}}
{{!PATHS_ONLY}}    # Application shell (ttyd, requires --base-path)
{{!PATHS_ONLY}}    location = {{VIBE4DOCK_BASE_PATH_APP_SHELL}} {
{{!PATHS_ONLY}}        proxy_set_header Host $host;
{{!PATHS_ONLY}}        proxy_set_header X-Real-IP $remote_addr;
{{!PATHS_ONLY}}        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
{{!PATHS_ONLY}}        proxy_set_header X-Forwarded-Proto $scheme;
{{!PATHS_ONLY}}        proxy_set_header Upgrade $http_upgrade;
{{!PATHS_ONLY}}        proxy_set_header Connection $vibe4dock_connection_upgrade;
{{!PATHS_ONLY}}        proxy_set_header Accept-Encoding "";
{{!PATHS_ONLY}}        sub_filter_types text/html;
{{!PATHS_ONLY}}        sub_filter_once on;
{{!PATHS_ONLY}}        sub_filter '</head>' '<style>*{scrollbar-width:thin;scrollbar-color:#2b3340 transparent}::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#2b3340;border-radius:5px}::-webkit-scrollbar-thumb:hover{background:#3d4757}</style><script>var t="Application Shell - Vibe4Dock";(function(){var d=Object.getOwnPropertyDescriptor(Document.prototype,"title");if(d&&d.set)d.set.call(document,t)})();Object.defineProperty(document,"title",{get:function(){return t},set:function(){}})</script></head>';
{{!PATHS_ONLY}}        set $vibe4dock_upstream_web "web";
{{!PATHS_ONLY}}        proxy_pass http://$vibe4dock_upstream_web:{{VIBE4DOCK_APP_SHELL_CONTAINER_PORT}};
{{!PATHS_ONLY}}    }
{{!PATHS_ONLY}}    location {{VIBE4DOCK_BASE_PATH_APP_SHELL}}/ {
{{!PATHS_ONLY}}        proxy_set_header Host $host;
{{!PATHS_ONLY}}        proxy_set_header X-Real-IP $remote_addr;
{{!PATHS_ONLY}}        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
{{!PATHS_ONLY}}        proxy_set_header X-Forwarded-Proto $scheme;
{{!PATHS_ONLY}}        proxy_set_header Upgrade $http_upgrade;
{{!PATHS_ONLY}}        proxy_set_header Connection $vibe4dock_connection_upgrade;
{{!PATHS_ONLY}}        proxy_set_header Accept-Encoding "";
{{!PATHS_ONLY}}        sub_filter_types text/html;
{{!PATHS_ONLY}}        sub_filter_once on;
{{!PATHS_ONLY}}        sub_filter '</head>' '<style>*{scrollbar-width:thin;scrollbar-color:#2b3340 transparent}::-webkit-scrollbar{width:10px;height:10px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#2b3340;border-radius:5px}::-webkit-scrollbar-thumb:hover{background:#3d4757}</style><script>var t="Application Shell - Vibe4Dock";(function(){var d=Object.getOwnPropertyDescriptor(Document.prototype,"title");if(d&&d.set)d.set.call(document,t)})();Object.defineProperty(document,"title",{get:function(){return t},set:function(){}})</script></head>';
{{!PATHS_ONLY}}        set $vibe4dock_upstream_web "web";
{{!PATHS_ONLY}}        proxy_pass http://$vibe4dock_upstream_web:{{VIBE4DOCK_APP_SHELL_CONTAINER_PORT}};
{{!PATHS_ONLY}}    }
{{!PATHS_ONLY}}
{{!PATHS_ONLY}}    # Web project (catch-all)
{{!PATHS_ONLY}}    location / {
{{!PATHS_ONLY}}        set $vibe4dock_upstream_web "web";
{{!PATHS_ONLY}}        proxy_pass http://$vibe4dock_upstream_web:{{VIBE4DOCK_WEB_CONTAINER_PORT}};
{{!PATHS_ONLY}}    }
{{!PATHS_ONLY}}
{{!PATHS_ONLY}}    # VIBE4DOCK_MANAGED_LOCATIONS_START
{{!PATHS_ONLY}}    # VIBE4DOCK_MANAGED_LOCATIONS_END
{{!PATHS_ONLY}}}
