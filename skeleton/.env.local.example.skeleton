# Uncomment and fill values to enable login protection.
# TOOLS_USERNAME="tools"
# TOOLS_PASSWORD="change-me-tools"
# APP_SHELL_USERNAME="application"
# APP_SHELL_PASSWORD="change-me-application"
# ROOT_SHELL_USERNAME="root"
# ROOT_SHELL_PASSWORD="change-me-root"

# Optional: poll interval in seconds for the rebuild watcher (host or container variant).
# WATCHER_POLL_INTERVAL="3"

# Optional: let the rebuild watcher run ./docker/rebuild.sh itself when a rebuild is requested.
# Set to "0" to keep the watcher in pure-logging mode (you will need to run rebuild.sh manually).
# Default: 1
# WATCHER_AUTO_REBUILD="1"

# Optional: extra debounce in seconds before the watcher triggers the rebuild, useful when
# multiple tool installs happen in quick succession. Default: 0
# WATCHER_REBUILD_DEBOUNCE="0"

# Optional: hard timeout for the rebuild command in seconds (0 = no timeout). Default: 0
# WATCHER_REBUILD_TIMEOUT="0"
